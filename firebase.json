{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "landing/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/app-release.apk",
        "destination": "https://github.com/cesarluisweb/gastoscan-ai/releases/latest/download/app-release.apk",
        "type": 302
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
