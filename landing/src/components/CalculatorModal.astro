<!-- Modal: Calculadora Cambiaria (Paridad con CurrencyCalculatorScreen) -->
<div
    id="modal-calculator"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-calculator-title"
    class="fixed inset-0 z-[90] bg-slate-900/40 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-4"
    style="z-index: 90;"
>
    <div class="bg-[#F9FAFB] rounded-3xl max-w-lg w-full shadow-2xl border border-slate-200 max-h-[92vh] flex flex-col overflow-hidden">
        <!-- Header -->
        <div class="flex justify-between items-center px-5 sm:px-6 py-4 border-b border-slate-200 bg-white">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#FEF08A] border border-[#FACC15] flex items-center justify-center text-base text-slate-900">🧮</span>
                <div>
                    <h3 id="modal-calculator-title" class="font-bold text-base sm:text-lg text-slate-900 leading-tight">Calculadora Cambiaria</h3>
                    <p class="text-[11px] text-slate-500">Conversión rápida en vivo y brecha cambiaria</p>
                </div>
            </div>
            <button
                type="button"
                id="btn-close-calculator"
                aria-label="Cerrar calculadora"
                class="text-slate-500 hover:text-slate-900 text-lg font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100 transition-colors"
            >✕</button>
        </div>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4">
            <!-- 4 Chips de Tasa Rápida -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" role="radiogroup" aria-label="Tipo de tasa de cambio">
                <button
                    type="button"
                    data-calc-rate="dolarBcv"
                    class="calc-rate-chip text-left px-3 py-2 rounded-xl border transition-all bg-[#FBF18F] border-[#FACC15] text-slate-900 shadow-sm"
                >
                    <span class="block text-xs font-bold text-slate-900">Dólar BCV</span>
                    <span id="calc-chip-sub-usd" class="block text-[11px] font-mono text-slate-800 mt-0.5">Bs. --</span>
                </button>
                <button
                    type="button"
                    data-calc-rate="euroBcv"
                    class="calc-rate-chip text-left px-3 py-2 rounded-xl border transition-all bg-white border-slate-200 text-slate-800 hover:border-slate-300"
                >
                    <span class="block text-xs font-semibold text-slate-900">Euro BCV</span>
                    <span id="calc-chip-sub-eur" class="block text-[11px] font-mono text-slate-500 mt-0.5">Bs. --</span>
                </button>
                <button
                    type="button"
                    data-calc-rate="usdtBinance"
                    class="calc-rate-chip text-left px-3 py-2 rounded-xl border transition-all bg-white border-slate-200 text-slate-800 hover:border-slate-300"
                >
                    <span class="block text-xs font-semibold text-slate-900">USDT P2P</span>
                    <span id="calc-chip-sub-usdt" class="block text-[11px] font-mono text-slate-500 mt-0.5">Bs. --</span>
                </button>
                <button
                    type="button"
                    data-calc-rate="personalizada"
                    class="calc-rate-chip text-left px-3 py-2 rounded-xl border transition-all bg-white border-slate-200 text-slate-800 hover:border-slate-300"
                >
                    <span class="block text-xs font-semibold text-slate-900">Personalizada ✏️</span>
                    <span id="calc-chip-sub-custom" class="block text-[11px] font-mono text-slate-500 mt-0.5">Manual</span>
                </button>
            </div>

            <!-- Contenedor de Tasa Personalizada -->
            <div id="calc-custom-rate-box" class="hidden bg-white p-3.5 rounded-2xl border border-[#FACC15] shadow-sm space-y-2">
                <label for="calc-custom-rate-input" class="block text-xs font-bold text-slate-900">
                    Tasa de Cambio Personalizada (Bs. / divisa)
                </label>
                <div class="relative flex items-center">
                    <span class="absolute left-3 text-sm font-bold text-slate-900 pointer-events-none select-none">Bs.</span>
                    <input
                        id="calc-custom-rate-input"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="0,00"
                        class="w-full pl-11 pr-9 py-2.5 text-base font-bold text-slate-900 caret-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FACC15] focus:border-[#FACC15]"
                    />
                    <button
                        type="button"
                        id="btn-calc-clear-custom"
                        aria-label="Limpiar tasa personalizada"
                        class="hidden absolute right-2.5 w-6 h-6 rounded-full text-slate-500 hover:text-slate-900 hover:bg-slate-100 items-center justify-center text-xs font-bold"
                    >✕</button>
                </div>
            </div>

            <!-- Tarjeta Principal de Conversión Bidireccional -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                <div id="calc-fields-stack" class="flex flex-col gap-3">
                    <!-- Bloque Divisa -->
                    <div id="calc-divisa-block" class="order-1">
                        <label id="calc-divisa-label" for="calc-divisa-input" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Monto en USD
                        </label>
                        <div class="relative flex items-center">
                            <span id="calc-divisa-prefix" class="absolute left-3.5 text-base font-extrabold text-slate-900 pointer-events-none select-none">$</span>
                            <input
                                id="calc-divisa-input"
                                type="text"
                                inputmode="decimal"
                                autocomplete="off"
                                placeholder="0.00"
                                class="w-full pl-12 pr-9 py-3 text-[22px] font-bold text-slate-900 caret-slate-900 placeholder:text-slate-300 bg-[#F9FAFB] focus:bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FACC15] focus:border-[#FACC15] tabular-nums"
                            />
                            <button
                                type="button"
                                id="btn-calc-clear-divisa"
                                aria-label="Limpiar monto en divisa"
                                class="hidden absolute right-2.5 w-7 h-7 rounded-full text-slate-500 hover:text-slate-900 hover:bg-slate-100 items-center justify-center text-xs font-bold"
                            >✕</button>
                        </div>
                    </div>

                    <!-- Pastilla Central Swap -->
                    <div class="order-2 flex justify-center">
                        <button
                            type="button"
                            id="btn-calc-swap"
                            title="Invertir sentido de conversión"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-[#FEF08A] border border-slate-200 hover:border-[#FACC15] text-xs font-bold text-slate-900 transition-colors"
                        >
                            <span aria-hidden="true">⇅</span>
                            <span id="calc-swap-rate-label" class="font-mono">1 USD = Bs. --</span>
                        </button>
                    </div>

                    <!-- Bloque Bolívares -->
                    <div id="calc-ves-block" class="order-3">
                        <label for="calc-ves-input" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Monto en Bolívares (VES)
                        </label>
                        <div class="relative flex items-center">
                            <span class="absolute left-3.5 text-base font-extrabold text-slate-900 pointer-events-none select-none">Bs.</span>
                            <input
                                id="calc-ves-input"
                                type="text"
                                inputmode="decimal"
                                autocomplete="off"
                                placeholder="0.00"
                                class="w-full pl-12 pr-9 py-3 text-[22px] font-bold text-slate-900 caret-slate-900 placeholder:text-slate-300 bg-[#F9FAFB] focus:bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FACC15] focus:border-[#FACC15] tabular-nums"
                            />
                            <button
                                type="button"
                                id="btn-calc-clear-ves"
                                aria-label="Limpiar monto en bolívares"
                                class="hidden absolute right-2.5 w-7 h-7 rounded-full text-slate-500 hover:text-slate-900 hover:bg-slate-100 items-center justify-center text-xs font-bold"
                            >✕</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción Rápida -->
            <div class="grid grid-cols-2 gap-2.5">
                <button
                    type="button"
                    id="btn-calc-copy"
                    class="inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-bold text-slate-900 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl transition-colors"
                >
                    <span aria-hidden="true">📋</span>
                    <span id="btn-calc-copy-label">Copiar Bs.</span>
                </button>
                <button
                    type="button"
                    id="btn-calc-register-expense"
                    class="inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-bold text-slate-900 bg-[#FACC15] hover:bg-[#EAB308] rounded-xl shadow-sm transition-colors"
                >
                    <span aria-hidden="true">+</span>
                    <span>Registrar gasto</span>
                </button>
            </div>

            <!-- Cuadro Comparativo Simultáneo -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <h4 class="text-sm font-bold text-slate-900">Comparativa simultánea</h4>
                    <span id="calc-comp-base-label" class="text-[11px] font-medium text-slate-500">Para 1,00 unidades en cada tasa</span>
                </div>

                <div id="calc-comp-rows" class="divide-y divide-slate-100">
                    <!-- Renderizado dinámicamente con textContent desde panel.astro -->
                </div>

                <!-- Indicador de Brecha Cambiaria -->
                <div class="flex items-center gap-2 px-3 py-2.5 rounded-xl bg-slate-100 border border-slate-200">
                    <span class="w-6 h-6 rounded-lg bg-[#FEF08A] border border-[#FACC15] flex items-center justify-center text-xs text-slate-900 shrink-0" aria-hidden="true">📊</span>
                    <span id="calc-brecha-text" class="text-xs font-bold text-slate-900">Brecha USDT vs Dólar BCV: —</span>
                </div>
            </div>

            <!-- Aviso Legal de Fuentes Públicas BCV -->
            <div class="bg-white px-3.5 py-3 rounded-2xl border border-slate-200 text-[11px] text-slate-600 leading-relaxed flex items-start gap-2.5">
                <span class="text-slate-500 shrink-0 mt-0.5" aria-hidden="true">ℹ️</span>
                <p>
                    Las tasas oficiales mostradas son estrictamente referenciales y provienen de fuentes públicas. Puedes verificar la cotización oficial directamente en
                    <a href="https://www.bcv.org.ve/" target="_blank" rel="noopener noreferrer" class="font-bold text-slate-900 underline hover:text-slate-700">bcv.org.ve</a>.
                </p>
            </div>
        </div>
    </div>
</div>
