        let dateRateRequestId = 0;

        const fetchHistoricalRatesForDate = async (dateStr) => {
            if (!dateStr || dateStr < '2023-01-03') return null;

            const cacheKey = `rm_hist_rates_${dateStr}`;
            try {
                const cached = sessionStorage.getItem(cacheKey);
                if (cached) {
                    return JSON.parse(cached);
                }
            } catch (_) {}

            const fetchList = async (url, storeKey) => {
                try {
                    const stored = sessionStorage.getItem(storeKey);
                    if (stored) {
                        const parsed = JSON.parse(stored);
                        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
                    }
                } catch (_) {}

                try {
                    const res = await fetch(url);
                    if (!res.ok) return [];
                    const list = await res.json();
                    if (Array.isArray(list)) {
                        try {
                            sessionStorage.setItem(storeKey, JSON.stringify(list));
                        } catch (_) {}
                        return list;
                    }
                } catch (_) {}
                return [];
            };

            try {
                const [dolarList, euroList, usdtList] = await Promise.all([
                    fetchList('https://ve.dolarapi.com/v1/historicos/dolares/oficial', 'rm_hist_dolares_oficial'),
                    fetchList('https://ve.dolarapi.com/v1/historicos/euros/oficial', 'rm_hist_euros_oficial'),
                    fetchList('https://ve.dolarapi.com/v1/historicos/dolares/paralelo', 'rm_hist_dolares_paralelo')
                ]);

                const findRate = (list) => {
                    let exact = null;
                    let lastPrior = null;
                    for (const item of list) {
                        const f = item.fecha || '';
                        if (f === dateStr) {
                            exact = { rate: Number(item.promedio), date: f, isExact: true };
                            break;
                        }
                        if (f && f <= dateStr) {
                            lastPrior = { rate: Number(item.promedio), date: f, isExact: false };
                        }
                    }
                    return exact || lastPrior;
                };

                const usdMatch = findRate(dolarList);
                const eurMatch = findRate(euroList);
                let usdtMatch = findRate(usdtList);
                if (!usdtMatch && usdMatch) {
                    usdtMatch = { ...usdMatch, fallback: true };
                }

                if (!usdMatch && !eurMatch && !usdtMatch) return null;

                const result = {
                    usd: usdMatch,
                    eur: eurMatch,
                    usdt: usdtMatch
                };

                try {
                    sessionStorage.setItem(cacheKey, JSON.stringify(result));
                } catch (_) {}

                return result;
            } catch (_) {
                return null;
            }
        };

        const fetchLiveRates = async () => {
            const fetchWithTimeout = async (url, timeoutMs = 6000) => {
                const controller = new AbortController();
                const id = setTimeout(() => controller.abort(), timeoutMs);
                try {
                    const res = await fetch(url, { signal: controller.signal });
                    clearTimeout(id);
                    return res.ok ? await res.json() : null;
                } catch (_) {
                    clearTimeout(id);
                    return null;
                }
            };

            try {
                const [dolarData, euroData, yadioData] = await Promise.all([
                    fetchWithTimeout('https://ve.dolarapi.com/v1/dolares/oficial'),
                    fetchWithTimeout('https://ve.dolarapi.com/v1/euros/oficial'),
                    fetchWithTimeout('https://api.yadio.io/json', 5000)
                ]);

                if (dolarData && dolarData.promedio > 0) {
                    liveRates.usd = Number(dolarData.promedio);
                }

                if (euroData && euroData.promedio > 0) {
                    liveRates.eur = Number(euroData.promedio);
