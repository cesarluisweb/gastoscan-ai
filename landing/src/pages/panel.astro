                if (labelMontoUsdEquiv) {
                    labelMontoUsdEquiv.classList.remove('hidden');
                    const equivUsd = currentTasa > 0 ? (total / currentTasa) : 0;
                    labelMontoUsdEquiv.textContent = `≈ ${formatMoney(equivUsd, 'USD')}`;
                }
            } else if (expMoneda === 'EUR') {
                setCurrencyButtonActive(btnCurrencyEur);
                if (labelTasaCambio) labelTasaCambio.textContent = "Tasa de cambio EUR (BCV)";
                if (labelMontoTotal) labelMontoTotal.textContent = "Monto Total (Euros €)";
                if (containerLiq) containerLiq.classList.remove('hidden');
                updateLiquidationDisplay();
                // Ocultar preview redundante en el título para EUR con liquidación
                if (labelMontoUsdEquiv) {
                    labelMontoUsdEquiv.classList.add('hidden');
                }
            } else if (expMoneda === 'USDT') {
                setCurrencyButtonActive(btnCurrencyUsdt);
                if (labelTasaCambio) labelTasaCambio.textContent = "Tasa de cambio USDT (P2P)";
                if (labelMontoTotal) labelMontoTotal.textContent = "Monto Total (USDT)";
                if (containerLiq) containerLiq.classList.add('hidden');
                if (labelMontoUsdEquiv) {
                    labelMontoUsdEquiv.classList.remove('hidden');
                    const equivVes = total * currentTasa;
                    labelMontoUsdEquiv.textContent = `≈ ${formatMoney(equivVes, 'VES')}`;
                }
            }
        };

        const selectCurrency = async (cur) => {
            expMoneda = cur;
            const f = modalExpFecha?.value;
            let rate = 0;
            if (f) {
                rate = await fetchHistoricalRate(f, cur);
            }
            if (!rate || rate <= 0) {
                rate = getRateForCurrency(cur);
            }
            if (modalExpTasa) {
                modalExpTasa.value = rate > 0 ? rate.toFixed(2) : '';
            }
            bolivaresAjustadosManualmente = false;
            updateCurrencyDisplay();
        };

        btnCurrencyUsd?.addEventListener('click', () => selectCurrency('USD'));
        btnCurrencyVes?.addEventListener('click', () => selectCurrency('VES'));
        btnCurrencyEur?.addEventListener('click', () => selectCurrency('EUR'));
        btnCurrencyUsdt?.addEventListener('click', () => selectCurrency('USDT'));

        document.querySelectorAll('.btn-liq-opt').forEach(btn => {
            btn.addEventListener('click', () => {
                selectedLiq = btn.getAttribute('data-liq') || 'BS_BCV';
                bolivaresAjustadosManualmente = false;
                updateLiquidationDisplay();
            });
        });

        modalExpFecha?.addEventListener('change', async () => {
            const f = modalExpFecha.value;
            if (!f) return;
            const hist = await fetchHistoricalRate(f, expMoneda);
            if (hist && hist > 0) {
                if (modalExpTasa) modalExpTasa.value = hist.toFixed(2);
                bolivaresAjustadosManualmente = false;
                updateCurrencyDisplay();
            }
        });

        modalExpTasa?.addEventListener('input', () => {
            bolivaresAjustadosManualmente = false;
            updateCurrencyDisplay();
        });

        modalExpTotal?.addEventListener('input', () => {
            bolivaresAjustadosManualmente = false;
            updateCurrencyDisplay();
        });

        btnAddItem?.addEventListener('click', () => {
            modalExpenseItems.push({
                descripcion: '',
                cantidad: 1,
                precio: '',
                total: '',
                categoria: 'Otros'
            });
            renderExpenseItems();
        });

        const openExpenseModal = () => {
            editingGastoId = null;
            const modalTitle = document.getElementById('modal-expense-title');
            if (modalTitle) modalTitle.textContent = "Registrar gasto";
            if (btnSaveExpenseModal) {
                const sp = btnSaveExpenseModal.querySelector('span');
                if (sp) sp.textContent = "Guardar Gasto";
            }

            modalExpComercio.value = '';
            modalExpTotal.value = '';
            selectedLiq = 'BS_BCV';
            expMoneda = 'USD'; // Desacoplado de activeLens
            bolivaresAjustadosManualmente = false;

            const rate = getRateForCurrency(expMoneda);
            if (modalExpTasa) modalExpTasa.value = rate > 0 ? rate.toFixed(2) : '';
            
            const d = new Date();
            const monthStr = String(selectedMonth).padStart(2, '0');
            const dayStr = String(d.getDate()).padStart(2, '0');
            modalExpFecha.value = `${selectedYear}-${monthStr}-${dayStr}`;

            // Iniciar con 1 ítem por defecto
            modalExpenseItems = [
                { descripcion: '', cantidad: 1, precio: '', total: '', categoria: 'Otros' }
            ];

            renderExpenseItems();
            updateCurrencyDisplay();

            modalExpense.classList.remove('hidden');
            modalExpense.classList.add('flex');
        };

        const openEditExpenseModal = (gasto) => {
            if (!gasto) return;
            editingGastoId = gasto.id;

            const modalTitle = document.getElementById('modal-expense-title');
            if (modalTitle) modalTitle.textContent = "Editar gasto";
            if (btnSaveExpenseModal) {
                const sp = btnSaveExpenseModal.querySelector('span');
                if (sp) sp.textContent = "Actualizar Gasto";
            }

            modalExpComercio.value = gasto.comercio || '';
            modalExpFecha.value = gasto.fecha || '';

            const esIndexadoBcv = (gasto.moneda === 'VES' && ((gasto.fuente_tasa_cambio || '').includes('indexado a USD') || (gasto.fuente_tasa_cambio || '').includes('BCV (Pago en Bs.')));
            const esIndexadoUsdt = (gasto.moneda === 'VES' && ((gasto.fuente_tasa_cambio || '').includes('indexado a USDT') || (gasto.fuente_tasa_cambio || '').includes('Binance P2P (Pago en Bs.')));

            const totalBsOriginal = (Number(gasto.total_original || 0) / 100.0);

            if (esIndexadoBcv) {
                expMoneda = 'USD';
                selectedLiq = 'BS_BCV';
                const totalUsd = (Number(gasto.total_usd || 0) / 100.0);
                modalExpTotal.value = totalUsd > 0 ? totalUsd.toFixed(2) : '';
                const tasaVal = Number(gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_cambio) : (liveRates.usd || 1.0);
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = true;
            } else if (esIndexadoUsdt) {
                expMoneda = 'USD';
                selectedLiq = 'BS_USDT';
                const totalUsdt = (Number(gasto.total_usdt || 0) / 100.0);
                modalExpTotal.value = totalUsdt > 0 ? totalUsdt.toFixed(2) : '';
                const tasaVal = Number(gasto.tasa_usdt || 0) > 0 ? Number(gasto.tasa_usdt) : (Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : 1.0);
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = true;
            } else {
                expMoneda = gasto.moneda || 'USD';
                selectedLiq = gasto.metodo_liquidacion || (expMoneda === 'USD' ? 'DIVISA' : 'BS_BCV');
                const totalOrig = (Number(gasto.total_original || 0) / 100.0);
                modalExpTotal.value = totalOrig > 0 ? totalOrig.toFixed(2) : '';
                const tasaVal = Number(gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_cambio) : (getRateForCurrency(expMoneda) || 1.0);
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = false;
            }

            // Ítems: si era indexado a USD, convertir montos de Bs a USD de display usando la tasa congelada
            const rateConversion = (esIndexadoBcv || esIndexadoUsdt) 
                ? (Number(modalExpTasa?.value) || 1.0) 
                : 1.0;

            if (gasto.items && gasto.items.length > 0) {
                modalExpenseItems = gasto.items.map(it => {
                    const cant = Number(it.cantidad) || 1;
                    const totRaw = (Number(it.total) || 0) / 100.0;
                    const prRaw = (Number(it.precio_unitario) || 0) / 100.0;

                    const tot = (esIndexadoBcv || esIndexadoUsdt) && rateConversion > 0
                        ? (totRaw / rateConversion)
                        : totRaw;
                    const pr = (esIndexadoBcv || esIndexadoUsdt) && rateConversion > 0
                        ? (prRaw / rateConversion)
                        : (prRaw > 0 ? prRaw : (cant > 0 ? tot / cant : tot));

                    return {
                        descripcion: it.descripcion || '',
                        cantidad: cant,
                        precio: pr > 0 ? pr.toFixed(2) : '',
                        total: tot > 0 ? tot.toFixed(2) : '',
                        categoria: it.categoria || 'Otros'
                    };
                });
            } else {
                modalExpenseItems = [
                    { descripcion: '', cantidad: 1, precio: '', total: '', categoria: gasto.categoria || 'Otros' }
                ];
            }

            renderExpenseItems();
            updateCurrencyDisplay();

            // Si es indexado, cargar el monto original en Bolívares en el input de Bs
            if (esIndexadoBcv || esIndexadoUsdt) {
                const bsInput = document.getElementById('modal-exp-bs-final');
                if (bsInput && totalBsOriginal > 0) {
                    bsInput.value = totalBsOriginal.toFixed(2);
                }
            }

            modalExpense.classList.remove('hidden');
            modalExpense.classList.add('flex');
        };

        const closeExpenseModal = () => {
            modalExpense.classList.add('hidden');
            modalExpense.classList.remove('flex');
        };

        btnOpenExpenseModal?.addEventListener('click', openExpenseModal);
        btnCloseExpenseModal?.addEventListener('click', closeExpenseModal);

        btnSaveExpenseModal?.addEventListener('click', async () => {
            if (!currentUser) return;

            const comercio = (modalExpComercio.value || '').trim() || 'Compra general';
            const fecha = modalExpFecha.value;
            let monto = Number(modalExpTotal.value || 0);

            if (!fecha) {
                alert("Por favor selecciona la fecha del gasto.");
                return;
            }
            if (monto <= 0) {
                alert("Por favor indica el monto total del gasto.");
                return;
            }

            // Alerta de discrepancia si hay ítems
            const sumItems = modalExpenseItems.reduce((acc, it) => acc + (Number(it.total) || 0), 0);
            if (modalExpenseItems.length > 0 && sumItems > 0 && Math.abs(sumItems - monto) > 0.05) {
                const ajustar = confirm(
                    `La suma de los productos (${formatMoney(sumItems, expMoneda)}) no coincide con el Monto Total (${formatMoney(monto, expMoneda)}).\n\n` +
                    `¿Deseas ajustar el Monto Total al valor de los productos?\n\n` +
                    `• Aceptar: Ajusta el Monto Total a ${formatMoney(sumItems, expMoneda)}\n` +
                    `• Cancelar: Mantiene el Monto Total actual (${formatMoney(monto, expMoneda)})`
                );
                if (ajustar) {
                    modalExpTotal.value = sumItems.toFixed(2);
                    monto = sumItems;
                    updateCurrencyDisplay();
                }
            }

            const tasa = Number(modalExpTasa.value) || getRateForCurrency(expMoneda) || 1.0;
            const tasaUsdt = Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : tasa;

            let monedaFinal = expMoneda;
            let totalOriginalCents = Math.round(monto * 100);
            let totalUsdCents = 0;
            let totalUsdtCents = 0;
            let fuenteTasa = expMoneda === 'USDT' ? 'Binance P2P' : 'BCV';
            let metodoLiqFinal = (expMoneda === 'USD' || expMoneda === 'EUR') ? selectedLiq : null;
            let ratioConversionItems = 1.0;

            if ((expMoneda === 'USD' || expMoneda === 'EUR') && (selectedLiq === 'BS_BCV' || selectedLiq === 'BS_USDT')) {
                // Liquidado en Bolívares
                monedaFinal = 'VES';
                const bsInput = document.getElementById('modal-exp-bs-final');
                let bsFinal = bsInput ? Number(bsInput.value || 0) : 0;
                if (bsFinal <= 0) {
                    bsFinal = selectedLiq === 'BS_BCV' ? (monto * tasa) : (monto * tasaUsdt);
                }

                totalOriginalCents = Math.round(bsFinal * 100);
                totalUsdCents = tasa > 0 ? Math.round((bsFinal / tasa) * 100) : Math.round(monto * 100);
                totalUsdtCents = tasaUsdt > 0 ? Math.round((bsFinal / tasaUsdt) * 100) : totalUsdCents;

                fuenteTasa = selectedLiq === 'BS_BCV'
                    ? 'BCV (Pago en Bs. indexado a USD)'
                    : 'Binance P2P (Pago en Bs. indexado a USDT)';
                
                ratioConversionItems = monto > 0 ? (bsFinal / monto) : (selectedLiq === 'BS_BCV' ? tasa : tasaUsdt);
            } else if (expMoneda === 'VES') {
                totalUsdCents = tasa > 0 ? Math.round((monto / tasa) * 100) : 0;
                totalUsdtCents = tasaUsdt > 0 ? Math.round((monto / tasaUsdt) * 100) : totalUsdCents;
                fuenteTasa = 'BCV';
            } else if (expMoneda === 'USD') {
                totalUsdCents = totalOriginalCents;
                totalUsdtCents = totalOriginalCents;
                fuenteTasa = 'BCV';
            } else if (expMoneda === 'EUR') {
                const equivVes = monto * tasa;
                const refUsd = liveRates.usd > 0 ? liveRates.usd : tasa;
                totalUsdCents = Math.round((equivVes / (refUsd > 0 ? refUsd : 1.0)) * 100);
                totalUsdtCents = totalUsdCents;
                fuenteTasa = 'BCV';
            } else if (expMoneda === 'USDT') {
                totalUsdCents = totalOriginalCents;
                totalUsdtCents = totalOriginalCents;
                fuenteTasa = 'Binance P2P';
            }

            // Preparar ítems para guardar con fallback Producto 1, Producto 2, etc.
            const validItems = modalExpenseItems
                .filter(it => (it.descripcion || '').trim() || (Number(it.total) || 0) > 0)
                .map((it, idx) => {
                    const cant = Number(it.cantidad) || 1;
                    const totNum = Number(it.total) || 0;
                    const prNum = Number(it.precio) || (cant > 0 ? totNum / cant : totNum);

                    // Escalar a Bolívares si se liquidó en Bolívares
                    const finalPr = prNum * ratioConversionItems;
                    const finalTot = totNum * ratioConversionItems;

                    return {
                        descripcion: (it.descripcion || '').trim() || `Producto ${idx + 1}`,
                        cantidad: cant,
                        precio_unitario: Math.round(finalPr * 100),
                        total: Math.round(finalTot * 100),
                        categoria: normalizarCategoria(it.categoria)
                    };
                });

            // Categoría principal del gasto
            let primaryCat = 'Otros';
            if (validItems.length > 0) {
                primaryCat = normalizarCategoria(validItems[0].categoria);
            }

            const gastoId = editingGastoId || (crypto.randomUUID ? crypto.randomUUID() : `web_${Date.now()}`);
            const docRef = doc(db, 'users', currentUser.uid, 'gastos', gastoId);

            try {
                btnSaveExpenseModal.disabled = true;
                btnSaveExpenseModal.innerHTML = `<span>Guardando...</span>`;

                const payload = {
                    uuid: gastoId,
                    comercio: comercio,
                    fecha: fecha,
                    moneda: monedaFinal,
                    total_original: totalOriginalCents,
                    total_usd: totalUsdCents,
                    total_usdt: totalUsdtCents,
                    tasa_cambio: tasa,
                    tasa_usdt: tasaUsdt,
                    metodo_liquidacion: metodoLiqFinal,
                    fuente_tasa_cambio: fuenteTasa,
                    fecha_tasa_cambio: fecha,
                    categoria: primaryCat,
                    items: validItems,
                    actualizado_en: new Date().toISOString(),
                    synced: 1
                };

                if (!editingGastoId) {
                    payload.creado_en = new Date().toISOString();
                }

                await setDoc(docRef, payload, { merge: true });

                closeExpenseModal();
                await loadDashboardData();
            } catch (err) {
                console.error("Error al registrar o actualizar factura:", err);
                alert("No se pudo guardar la factura.");
            } finally {
                btnSaveExpenseModal.disabled = false;
                btnSaveExpenseModal.innerHTML = `<span>${editingGastoId ? 'Actualizar Gasto' : 'Guardar Gasto'}</span>`;
            }
        });

    </script>
</body>
</html>
