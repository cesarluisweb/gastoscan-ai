                    ` : ''}

                    <div class="mt-3 pt-2 border-t border-slate-100 flex justify-end gap-3">
                        <button class="btn-edit-expense text-[11px] font-semibold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-1" data-id="${escapeHtml(gasto.id)}">
