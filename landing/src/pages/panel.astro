        const updateCurrencyDisplay = () => {
            const currentTasa = Number(modalExpTasa?.value) || getRateForCurrency(expMoneda) || 1;
            const total = Number(modalExpTotal?.value) || 0;
            const containerLiq = document.getElementById('container-liquidacion-usd');

