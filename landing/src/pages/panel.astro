        const btnOpenExpenseModal = document.getElementById('btn-open-expense-modal');
        const btnCloseExpenseModal = document.getElementById('btn-close-expense-modal');
        const btnSaveExpenseModal = document.getElementById('btn-save-expense-modal');
        const modalExpComercio = document.getElementById('modal-exp-comercio');
        const modalExpFecha = document.getElementById('modal-exp-fecha');
        const modalExpItemsList = document.getElementById('modal-exp-items-list');
        const btnAddItem = document.getElementById('btn-add-item');
        const itemsCountBadge = document.getElementById('items-count-badge');
        const btnCurrencyUsd = document.getElementById('btn-currency-usd');
        const btnCurrencyVes = document.getElementById('btn-currency-ves');
        const btnCurrencyEur = document.getElementById('btn-currency-eur');
        const btnCurrencyUsdt = document.getElementById('btn-currency-usdt');
        const containerTasaCambio = document.getElementById('container-tasa-cambio');
        const labelTasaCambio = document.getElementById('label-tasa-cambio');
        const modalExpTasa = document.getElementById('modal-exp-tasa');
        const labelMontoTotal = document.getElementById('label-monto-total');
        const labelMontoUsdEquiv = document.getElementById('label-monto-usd-equiv');
        const modalExpTotal = document.getElementById('modal-exp-total');

        // Helpers de Formato Multimoneda (USD, VES, EUR, USDT)
        const formatMoney = (amount, currency = 'USD') => {
            const num = Number(amount || 0);
            const formatted = num.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            switch ((currency || 'USD').toUpperCase()) {
                case 'VES':
                    return `Bs. ${formatted}`;
                case 'EUR':
                    return `€ ${formatted}`;
                case 'USDT':
                    return `${formatted} USDT`;
                case 'USD':
                default:
                    return `$${formatted}`;
            }
        };

        const getDocId = (year, month) => `${year}_${String(month).padStart(2, '0')}`;

        // Autenticación
        const handleLogin = async () => {
            try {
                await signInWithPopup(auth, provider);
            } catch (err) {
                console.error("Error al iniciar sesión:", err);
                alert("No se pudo iniciar sesión con Google. Revisa la consola o configuración de dominios.");
            }
        };

        btnLoginTop?.addEventListener('click', handleLogin);
        btnLoginHero?.addEventListener('click', handleLogin);
        btnLogout?.addEventListener('click', async () => {
            await signOut(auth);
        });

        onAuthStateChanged(auth, async (user) => {
            viewLoading.classList.add('hidden');
            if (user) {
                currentUser = user;
                btnLoginTop.classList.add('hidden');
                viewLoggedOut.classList.add('hidden');
                
                userProfileMenu.classList.remove('hidden');
                userProfileMenu.classList.add('flex');
                userAvatar.src = user.photoURL || '/logo.jpg';
                userName.textContent = user.displayName || user.email;

                viewDashboard.classList.remove('hidden');
                await loadDashboardData();
            } else {
                currentUser = null;
                btnLoginTop.classList.remove('hidden');
                btnLoginTop.classList.add('inline-flex');
                userProfileMenu.classList.add('hidden');
                viewDashboard.classList.add('hidden');
                viewLoggedOut.classList.remove('hidden');
            }
