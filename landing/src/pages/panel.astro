        let officialRates = {
            usd: 36.5,
            eur: 40.0,
            usdt: 36.5,
        };

        // DOM Elements
        const modalExpItemsTitle = document.getElementById('modal-exp-items-title');
        const modalExpItemsMonedaLabel = document.getElementById('modal-exp-items-moneda-label');
        const btnAddItemText = document.getElementById('btn-add-item-text');
        const modalExpTotalPrefix = document.getElementById('modal-exp-total-prefix');
        const modalExpDiscrepancyBanner = document.getElementById('modal-exp-discrepancy-banner');
        const modalExpDiscrepancyText = document.getElementById('modal-exp-discrepancy-text');
        const modalExpFechaInfo = document.getElementById('modal-exp-fecha-info');
        const modalExpFechaInfoText = document.getElementById('modal-exp-fecha-info-text');

