        const firebaseConfig = {
            apiKey: "AIzaSyA5HMxpemkmCC-uKwMIyP9TP3Cxf8MDq8o",
            authDomain: "gastoscan-ai.firebaseapp.com",
            projectId: "gastoscan-ai",
            storageBucket: "gastoscan-ai.firebasestorage.app",
            messagingSenderId: "758679432067",
            appId: "1:758679432067:web:panel"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // Habilitar persistencia offline para que cargue instantáneamente
        enableIndexedDbPersistence(db).catch(() => {
            // Ignorar si el navegador no soporta IndexedDB multi-tab
        });

        const provider = new GoogleAuthProvider();

        const CATEGORIAS_DEF = [
            'Alimentación',
            'Salud',
            'Higiene',
            'Educación',
            'Hogar',
            'Servicios',
            'Transporte',
            'Otros'
        ];

        const CATEGORIA_ICONS = {
            'Alimentación': '🛒',
            'Salud': '💊',
            'Higiene': '🧼',
            'Educación': '📚',
            'Hogar': '🏠',
            'Servicios': '💡',
            'Transporte': '🚗',
            'Otros': '📦',
            // Compatibilidad hacia atrás
            'Alimentos': '🛒',
            'Entretenimiento': '🎬',
            'Ropa': '👕'
        };

        const normalizarCategoria = (cat) => {
            if (!cat) return 'Otros';
            const trimmed = String(cat).trim();
            const lower = trimmed.toLowerCase();
            if (lower === 'alimentos' || lower === 'alimentacion' || lower === 'alimentación' || lower === 'comida') return 'Alimentación';
            if (lower === 'salud' || lower === 'medicina' || lower === 'farmacia') return 'Salud';
            if (lower === 'higiene' || lower === 'aseo') return 'Higiene';
            if (lower === 'educacion' || lower === 'educación') return 'Educación';
            if (lower === 'hogar' || lower === 'casa') return 'Hogar';
            if (lower === 'servicios' || lower === 'servicio') return 'Servicios';
            if (lower === 'transporte' || lower === 'gasolina' || lower === 'pasaje') return 'Transporte';
            const match = CATEGORIAS_DEF.find(c => c.toLowerCase() === lower);
            return match || 'Otros';
        };

        const MONTH_NAMES = [
            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
        ];

        // Estado de la Aplicación
        let currentUser = null;
        const now = new Date();
        let selectedYear = now.getFullYear();
        let selectedMonth = now.getMonth() + 1; // 1 - 12
        let currentGastos = [];
        let currentPresupuesto = { general: 0, meta_ahorro: 0, moneda: 'USD', categorias: {} };
        let activeLens = null;
        let selectedLiq = 'BS_BCV';
        let editingGastoId = null;
        let bolivaresAjustadosManualmente = false;

        // Tasas de Referencia en Vivo (USD BCV, EUR BCV, USDT Binance / Paralelo)
        let liveRates = {
            usd: 36.5,
            eur: 0.0,
            usdt: 36.5,
            timestamp: null
        };

        const updateRatesTicker = () => {
            const elUsd = document.getElementById('rate-usd-val');
            const elEur = document.getElementById('rate-eur-val');
            const elUsdt = document.getElementById('rate-usdt-val');
            if (elUsd) elUsd.textContent = liveRates.usd > 0 ? `Bs. ${liveRates.usd.toFixed(2)}` : 'Bs. --';
            if (elEur) elEur.textContent = liveRates.eur > 0 ? `Bs. ${liveRates.eur.toFixed(2)}` : 'Bs. --';
            if (elUsdt) elUsdt.textContent = liveRates.usdt > 0 ? `Bs. ${liveRates.usdt.toFixed(2)}` : 'Bs. --';
        };

        const updateLensSelectorUI = () => {
            const current = activeLens || currentPresupuesto.moneda || 'USD';
            const buttons = document.querySelectorAll('.panel-lens-btn');
            buttons.forEach(btn => {
                const l = btn.getAttribute('data-lens');
                if (l === current) {
                    btn.className = "panel-lens-btn flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm";
                } else {
                    btn.className = "panel-lens-btn flex-1 sm:flex-none px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-slate-600 hover:text-slate-900";
                }
            });
        };

        const getRateForCurrency = (currency) => {
            switch ((currency || 'USD').toUpperCase()) {
                case 'EUR':
                    return liveRates.eur > 0 ? liveRates.eur : (liveRates.usd > 0 ? liveRates.usd : 880.0);
                case 'USDT':
                    return liveRates.usdt > 0 ? liveRates.usdt : (liveRates.usd > 0 ? liveRates.usd : 880.0);
                case 'VES':
                case 'USD':
                default:
                    return liveRates.usd > 0 ? liveRates.usd : 880.0;
            }
        };

        const fetchHistoricalRate = async (dateStr, currency = 'USD') => {
            try {
                let endpoint = 'https://ve.dolarapi.com/v1/historicos/dolares/oficial';
                if (currency === 'EUR') endpoint = 'https://ve.dolarapi.com/v1/historicos/euros/oficial';
                else if (currency === 'USDT') endpoint = 'https://ve.dolarapi.com/v1/historicos/dolares/paralelo';

                const res = await fetch(endpoint);
                if (!res.ok) return null;
                const list = await res.json();
                if (!Array.isArray(list)) return null;

                let lastValid = null;
                for (const it of list) {
                    const f = it.fecha || '';
                    if (f === dateStr) {
                        return Number(it.promedio) || null;
                    }
                    if (f && f <= dateStr) {
                        lastValid = Number(it.promedio) || lastValid;
                    }
                }
                return lastValid;
            } catch (_) {
                return null;
            }
        };

        const fetchLiveRates = async () => {
            const fetchWithTimeout = async (url, timeoutMs = 6000) => {
                const controller = new AbortController();
                const id = setTimeout(() => controller.abort(), timeoutMs);
                try {
                    const res = await fetch(url, { signal: controller.signal });
                    clearTimeout(id);
                    return res.ok ? await res.json() : null;
                } catch (_) {
                    clearTimeout(id);
                    return null;
                }
            };

            try {
                const [dolarData, euroData, yadioData] = await Promise.all([
                    fetchWithTimeout('https://ve.dolarapi.com/v1/dolares/oficial'),
                    fetchWithTimeout('https://ve.dolarapi.com/v1/euros/oficial'),
                    fetchWithTimeout('https://api.yadio.io/json', 5000)
                ]);

                if (dolarData && dolarData.promedio > 0) {
                    liveRates.usd = Number(dolarData.promedio);
                } else if (yadioData?.USD?.other?.official?.rate > 0) {
                    liveRates.usd = Number(yadioData.USD.other.official.rate);
                }

                if (euroData && euroData.promedio > 0) {
                    liveRates.eur = Number(euroData.promedio);
                } else if (yadioData?.EUR?.rate > 0) {
                    liveRates.eur = Number(yadioData.EUR.rate);
                }

                if (yadioData && yadioData.USD && yadioData.USD.other && yadioData.USD.other.p2p_usdt && yadioData.USD.other.p2p_usdt.rate > 0) {
                    liveRates.usdt = Number(yadioData.USD.other.p2p_usdt.rate);
                } else if (yadioData && yadioData.USD && yadioData.USD.rate > 0) {
                    liveRates.usdt = Number(yadioData.USD.rate);
                } else {
                    const paraleloData = await fetchWithTimeout('https://ve.dolarapi.com/v1/dolares/paralelo', 3000);
                    if (paraleloData && paraleloData.promedio > 0) {
                        liveRates.usdt = Number(paraleloData.promedio);
                    } else if (liveRates.usd > 0) {
                        liveRates.usdt = liveRates.usd;
                    }
                }

                // Fallback adicional si faltan tasas: jsDelivr CDN
                if (liveRates.usd <= 0 || liveRates.eur <= 0) {
                    const [jsdelivrUsd, jsdelivrEur] = await Promise.all([
                        liveRates.usd <= 0 ? fetchWithTimeout('https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json', 4000) : null,
                        liveRates.eur <= 0 ? fetchWithTimeout('https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/eur.json', 4000) : null
                    ]);
                    if (liveRates.usd <= 0 && jsdelivrUsd?.usd?.ves > 0) {
                        liveRates.usd = Number(jsdelivrUsd.usd.ves);
                    }
                    if (liveRates.eur <= 0 && jsdelivrEur?.eur?.ves > 0) {
                        liveRates.eur = Number(jsdelivrEur.eur.ves);
                    }
                }

                liveRates.timestamp = new Date();
                updateRatesTicker();
            } catch (err) {
                console.warn("Fallo al actualizar tasas en vivo:", err);
            }
        };

        fetchLiveRates();

        // Elementos DOM
        const viewLoading = document.getElementById('view-loading');
        const viewLoggedOut = document.getElementById('view-logged-out');
        const viewDashboard = document.getElementById('view-dashboard');

        const btnLoginTop = document.getElementById('btn-login-top');
        const btnLoginHero = document.getElementById('btn-login-hero');
        const btnLogout = document.getElementById('btn-logout');
        const userProfileMenu = document.getElementById('user-profile-menu');
        const userAvatar = document.getElementById('user-avatar');
        const userName = document.getElementById('user-name');

        const currentMonthDisplay = document.getElementById('current-month-display');
        const btnPrevMonth = document.getElementById('btn-prev-month');
        const btnNextMonth = document.getElementById('btn-next-month');
        const btnTodayMonth = document.getElementById('btn-today-month');

        const cardBudgetAmount = document.getElementById('card-budget-amount');
        const cardCurrencyBadge = document.getElementById('card-currency-badge');
