            setAuthMessage('');
            if (btnAuthEmailSubmit) {
                btnAuthEmailSubmit.disabled = true;
                const sp = btnAuthEmailSubmit.querySelector('span');
                if (sp) sp.textContent = isRegisterMode ? 'Creando cuenta...' : 'Verificando...';
