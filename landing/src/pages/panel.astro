        // Selector de Mes
        const updateMonthDisplay = () => {
            currentMonthDisplay.textContent = `${MONTH_NAMES[selectedMonth - 1]} ${selectedYear}`;
        };

        btnPrevMonth?.addEventListener('click', async () => {
            if (selectedMonth === 1) {
                selectedMonth = 12;
                selectedYear -= 1;
            } else {
                selectedMonth -= 1;
            }
            updateMonthDisplay();
            await loadDashboardData();
        });

        btnNextMonth?.addEventListener('click', async () => {
            if (selectedMonth === 12) {
                selectedMonth = 1;
                selectedYear += 1;
            } else {
                selectedMonth += 1;
            }
            updateMonthDisplay();
            await loadDashboardData();
        });

        btnTodayMonth?.addEventListener('click', async () => {
            const today = new Date();
            selectedYear = today.getFullYear();
            selectedMonth = today.getMonth() + 1;
            updateMonthDisplay();
            await loadDashboardData();
        });

        document.querySelectorAll('.panel-lens-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                activeLens = btn.getAttribute('data-lens');
                updateLensSelectorUI();
                renderMetrics();
                renderCategories();
            });
        });

        // Carga de Datos desde Firestore
        const loadDashboardData = async () => {
            if (!currentUser) return;
            updateMonthDisplay();

            const monthPrefix = `${selectedYear}-${String(selectedMonth).padStart(2, '0')}`;
            const docId = getDocId(selectedYear, selectedMonth);

            try {
                // 1. Cargar Presupuesto del Mes
                const budgetRef = doc(db, 'users', currentUser.uid, 'presupuestos', docId);
                const budgetSnap = await getDoc(budgetRef);
                if (budgetSnap.exists()) {
                    const data = budgetSnap.data();
                    currentPresupuesto = {
                        general: Number(data.presupuesto_general || 0),
                        meta_ahorro: Number(data.meta_ahorro || 0),
                        moneda: data.moneda || 'USD',
                        categorias: data.categorias || {}
                    };
                } else {
                    currentPresupuesto = { general: 0, meta_ahorro: 0, moneda: 'USD', categorias: {} };
                }

                // 2. Cargar Gastos
                const gastosRef = collection(db, 'users', currentUser.uid, 'gastos');
                const gastosSnap = await getDocs(gastosRef);

                currentGastos = [];
                gastosSnap.forEach(d => {
                    const g = d.data();
                    if (!g.eliminado_en && g.fecha && g.fecha.startsWith(monthPrefix)) {
                        currentGastos.push({
                            id: d.id,
                            ...g
                        });
                    }
                });

                // Ordenar más recientes primero
                currentGastos.sort((a, b) => (b.fecha || '').localeCompare(a.fecha || ''));

                renderMetrics();
                renderCategories();
                renderBills();
            } catch (err) {
                console.error("Error al cargar datos de Firestore:", err);
            }
        };

        // Calculadora de Salud Financiera y Ahorro (Paridad exacta con app móvil)
        const calculateSavingsHealth = ({
            presupuestoGeneral,
            metaAhorro,
            gastoAcumulado,
            diaActual,
            diasTotalesMes,
            diasGracia = 3
        }) => {
            const gen = Math.max(0, Number(presupuestoGeneral) || 0);
            const metaClamped = Math.max(0, Math.min(Number(metaAhorro) || 0, gen));
            const limite = Math.max(0, gen - metaClamped);
            const gasto = Math.max(0, Number(gastoAcumulado) || 0);
            const disponible = Math.max(0, limite - gasto);

            const totalDias = diasTotalesMes > 0 ? diasTotalesMes : 30;
            const diasValidos = Math.max(1, Math.min(diaActual, totalDias));

            const gastoDiario = diasValidos > 0 ? (gasto / diasValidos) : 0;
            const gastoProyectado = gastoDiario * totalDias;

            let status = 'sinMeta';
            if (metaClamped <= 0) {
                status = 'sinMeta';
            } else if (gasto > limite) {
                status = 'comprometida';
            } else if (diasValidos <= diasGracia) {
                status = 'protegida';
            } else if (gastoProyectado > limite) {
                status = 'enRiesgo';
            } else {
                status = 'protegida';
            }

            return {
                presupuestoGeneral: gen,
                metaAhorro: metaClamped,
                limiteParaGastar: limite,
                gastoAcumulado: gasto,
                disponibleParaGastar: disponible,
                diasTranscurridos: diasValidos,
                diasTotalesMes: totalDias,
                gastoDiarioPromedio: gastoDiario,
                gastoProyectadoFinDeMes: gastoProyectado,
                status
            };
        };

        // Conversión determinista de presupuestos al lente activo (Paridad con SummaryCard y DatabaseHelper)
        const convertBudgetToLens = (amount, fromCurrency, toCurrency) => {
            if (!amount || amount <= 0) return 0;
            if (fromCurrency === toCurrency) return amount;

            // 1. Convertir fromCurrency a USD base
            let inUsd = amount;
            if (fromCurrency === 'VES') {
                const rate = (liveRates.usd > 0) ? liveRates.usd : 1.0;
                inUsd = amount / rate;
            } else if (fromCurrency === 'EUR') {
                const eurRate = (liveRates.eur > 0) ? liveRates.eur : 1.0;
                const usdRate = (liveRates.usd > 0) ? liveRates.usd : 1.0;
                inUsd = (amount * eurRate) / usdRate;
            } else if (fromCurrency === 'USDT') {
                inUsd = amount;
            }

            // 2. Proyectar de USD al lente activo toCurrency
            if (toCurrency === 'USD' || toCurrency === 'USDT') {
                return inUsd;
            }
            if (toCurrency === 'VES') {
                const rate = (liveRates.usd > 0) ? liveRates.usd : 1.0;
                return inUsd * rate;
            }
            if (toCurrency === 'EUR') {
                const eurRate = (liveRates.eur > 0) ? liveRates.eur : 1.0;
                const usdRate = (liveRates.usd > 0) ? liveRates.usd : 1.0;
                return (inUsd * usdRate) / eurRate;
            }
            return amount;
        };

        // Renderizado de Métricas Clave (Paridad exacta con DatabaseHelper y SummaryCard)
        const renderMetrics = () => {
            let sumUsd = 0;
            let sumVes = 0;
            let sumUsdt = 0;

            currentGastos.forEach(g => {
                const totalUsd = (Number(g.total_usd || 0)) / 100.0;
                const totalOrig = (Number(g.total_original || 0)) / 100.0;
                const tasa = Number(g.tasa_cambio || 0) > 0 ? Number(g.tasa_cambio) : (liveRates.usd || 1.0);

                sumUsd += totalUsd;

                let totalUsdt = 0;
                if (g.total_usdt !== undefined && g.total_usdt !== null) {
                    totalUsdt = (Number(g.total_usdt || 0)) / 100.0;
                } else if (g.moneda !== 'VES') {
                    totalUsdt = totalUsd;
                } else {
                    const tUsdt = Number(g.tasa_usdt || 0) > 0 ? Number(g.tasa_usdt) : (Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : 0);
                    totalUsdt = tUsdt > 0 ? (totalOrig / tUsdt) : totalUsd;
                }
                sumUsdt += totalUsdt;

                if (g.moneda === 'VES') {
                    // Inmutabilidad del bolívar: los gastos en VES suman su monto original
                    sumVes += totalOrig;
                } else {
                    // Gastos en divisas (USD, EUR, USDT) se convierten determinísticamente con su tasa
                    sumVes += (totalUsd * (tasa > 0 ? tasa : 1.0));
                }
            });

            const budgetCurrency = currentPresupuesto.moneda || 'USD';
            const displayCurrency = activeLens || budgetCurrency;
            let effectiveSpent = 0;
            if (displayCurrency === 'VES') {
                effectiveSpent = sumVes;
            } else if (displayCurrency === 'EUR') {
                effectiveSpent = liveRates.eur > 0 ? (sumVes / liveRates.eur) : (liveRates.usd > 0 ? (sumVes / liveRates.usd) : sumUsd);
            } else if (displayCurrency === 'USDT') {
                effectiveSpent = sumUsdt;
            } else {
                effectiveSpent = sumUsd;
            }

            updateLensSelectorUI();

            // Fechas y Días
            const today = new Date();
            const isCurrentMonth = (today.getFullYear() === selectedYear && (today.getMonth() + 1) === selectedMonth);
            const diasTotalesMes = new Date(selectedYear, selectedMonth, 0).getDate();
            const diaActual = isCurrentMonth ? today.getDate() : diasTotalesMes;
            const diasRestantes = isCurrentMonth ? Math.max(0, diasTotalesMes - today.getDate()) : 0;

            // Convertir presupuesto y meta de ahorro a la divisa del lente activo
            const effectiveGeneralBudget = convertBudgetToLens(currentPresupuesto.general, budgetCurrency, displayCurrency);
            const effectiveMetaAhorro = convertBudgetToLens(currentPresupuesto.meta_ahorro || 0, budgetCurrency, displayCurrency);

            // Salud de Ahorro
            const health = calculateSavingsHealth({
                presupuestoGeneral: effectiveGeneralBudget,
                metaAhorro: effectiveMetaAhorro,
                gastoAcumulado: effectiveSpent,
                diaActual,
                diasTotalesMes
            });

            const hasBudget = effectiveGeneralBudget > 0;
            const hasSavings = health.metaAhorro > 0;
            const targetBudget = hasSavings ? health.limiteParaGastar : effectiveGeneralBudget;

            // Tarjeta 1: Presupuesto
            cardBudgetAmount.textContent = formatMoney(effectiveGeneralBudget, displayCurrency);
            cardCurrencyBadge.textContent = displayCurrency;
            if (hasSavings) {
                cardBudgetStatus.textContent = `Límite: ${formatMoney(health.limiteParaGastar, displayCurrency)}`;
                cardBudgetSavingsInfo.classList.remove('hidden');
                cardBudgetSavingsInfo.textContent = `Meta ahorro: ${formatMoney(health.metaAhorro, displayCurrency)}`;
            } else {
                cardBudgetStatus.textContent = 'Límite mensual';
                cardBudgetSavingsInfo.classList.add('hidden');
            }

            // Tarjeta 2: Gastado
            cardSpentUsd.textContent = formatMoney(effectiveSpent, displayCurrency);
            if (displayCurrency === 'VES') {
                cardSpentVes.textContent = sumUsd > 0 ? `≈ ${formatMoney(sumUsd, 'USD')} en dólares` : 'Sin compras en divisas';
            } else {
                cardSpentVes.textContent = sumVes > 0 ? `≈ ${formatMoney(sumVes, 'VES')} en bolívares` : 'Sin compras en bolívares';
            }

            // Tarjeta 3: Restante y Salud
            if (hasBudget) {
                const diff = targetBudget - effectiveSpent;
                if (diff >= 0) {
                    cardRemainingAmount.textContent = formatMoney(diff, displayCurrency);
                    cardRemainingAmount.className = "text-xl sm:text-2xl font-extrabold text-emerald-600";
                    cardRemainingBadge.textContent = hasSavings ? "Disponible para gastar" : "Disponible";
                    cardRemainingBadge.className = "text-[11px] font-semibold text-emerald-600";
                } else {
                    cardRemainingAmount.textContent = `-${formatMoney(Math.abs(diff), displayCurrency)}`;
                    cardRemainingAmount.className = "text-xl sm:text-2xl font-extrabold text-rose-600";
                    cardRemainingBadge.textContent = hasSavings ? "Límite superado" : "Presupuesto superado";
                    cardRemainingBadge.className = "text-[11px] font-semibold text-rose-600";
                }

                // Badge de Salud del Ahorro
                if (hasSavings) {
                    cardSavingsBadge.classList.remove('hidden');
                    if (health.status === 'protegida') {
                        cardSavingsBadge.className = "text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 border border-emerald-200";
                        cardSavingsBadge.textContent = "🛡️ Ahorro protegido";
                    } else if (health.status === 'enRiesgo') {
                        cardSavingsBadge.className = "text-[10px] px-2 py-0.5 rounded-full font-bold bg-amber-100 text-amber-800 border border-amber-200";
                        cardSavingsBadge.textContent = "⚠️ Ahorro en riesgo";
                    } else if (health.status === 'comprometida') {
                        cardSavingsBadge.className = "text-[10px] px-2 py-0.5 rounded-full font-bold bg-rose-100 text-rose-800 border border-rose-200";
                        cardSavingsBadge.textContent = "🚨 Ahorro comprometido";
                    }
                } else {
                    cardSavingsBadge.classList.add('hidden');
                }
            } else {
                cardRemainingAmount.textContent = "Sin límite";
                cardRemainingAmount.className = "text-xl sm:text-2xl font-extrabold text-slate-400";
                cardRemainingBadge.textContent = "Define un presupuesto";
                cardRemainingBadge.className = "text-[11px] font-semibold text-slate-400";
                cardSavingsBadge.classList.add('hidden');
            }

            // Tarjeta 4: Facturas
            cardBillsCount.textContent = currentGastos.length.toString();
            const avg = currentGastos.length > 0 ? (effectiveSpent / currentGastos.length) : 0;
            cardBillsAverage.textContent = `Promedio: ${formatMoney(avg, displayCurrency)}`;

            // Ritmo Diario
            if (hasBudget && targetBudget > 0) {
                if (isCurrentMonth) {
                    const rem = Math.max(0, targetBudget - effectiveSpent);
                    const diasCalculo = diasRestantes > 0 ? diasRestantes : 1;
                    const ritmo = rem / diasCalculo;
                    const diasTexto = diasRestantes === 1 ? 'Falta 1 día' : `Faltan ${diasRestantes} días`;
                    cardDailyPace.textContent = `${diasTexto} • Ritmo sugerido: ${formatMoney(ritmo, displayCurrency)}/día`;
                } else {
                    cardDailyPace.textContent = effectiveSpent <= targetBudget
                        ? `Período cerrado • Ahorraste ${formatMoney(targetBudget - effectiveSpent, displayCurrency)}`
                        : `Período cerrado • Superado por ${formatMoney(effectiveSpent - targetBudget, displayCurrency)}`;
                }
            } else {
                cardDailyPace.textContent = isCurrentMonth ? `Faltan ${diasRestantes} días para el cierre` : 'Período cerrado';
            }

            // Barra de Progreso
            if (hasBudget && targetBudget > 0) {
                const percent = Math.round((effectiveSpent / targetBudget) * 100);
                if (progressTitleLabel) {
                    progressTitleLabel.textContent = hasSavings ? "Consumo del límite para gastar" : "Consumo del presupuesto";
                }
                progressPercentLabel.textContent = `${percent}% consumido`;
                progressBarFill.style.width = `${Math.min(percent, 100)}%`;
                
                if (percent > 100) {
                    progressBarFill.className = "bg-rose-500 h-3 rounded-full transition-all duration-500";
                } else if (percent >= 85) {
                    progressBarFill.className = "bg-amber-500 h-3 rounded-full transition-all duration-500";
                } else {
                    progressBarFill.className = "bg-emerald-500 h-3 rounded-full transition-all duration-500";
                }
            } else {
                if (progressTitleLabel) progressTitleLabel.textContent = "Consumo del presupuesto";
                progressPercentLabel.textContent = "0% (Sin presupuesto fijado)";
                progressBarFill.style.width = "0%";
            }
        };

        // Renderizado de Categorías (Paridad con DatabaseHelper.getCategoryTotals)
        const renderCategories = () => {
            categoriesList.innerHTML = '';

            const budgetCurrency = currentPresupuesto.moneda || 'USD';
            const displayCurrency = activeLens || budgetCurrency;
            const catSpent = {};
            CATEGORIAS_DEF.forEach(c => catSpent[c] = 0);

            currentGastos.forEach(g => {
                const gastoCat = normalizarCategoria(g.categoria);
                const totalUsd = (Number(g.total_usd || 0)) / 100.0;
                const totalOrig = (Number(g.total_original || 0)) / 100.0;
                const tasa = Number(g.tasa_cambio || 0) > 0 ? Number(g.tasa_cambio) : (liveRates.usd || 1.0);

                let totalUsdt = 0;
                if (g.total_usdt !== undefined && g.total_usdt !== null) {
                    totalUsdt = (Number(g.total_usdt || 0)) / 100.0;
                } else if (g.moneda !== 'VES') {
                    totalUsdt = totalUsd;
                } else {
                    const tUsdt = Number(g.tasa_usdt || 0) > 0 ? Number(g.tasa_usdt) : (Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : 0);
                    totalUsdt = tUsdt > 0 ? (totalOrig / tUsdt) : totalUsd;
                }

                let targetTotal = 0;
                if (displayCurrency === 'VES') {
                    targetTotal = g.moneda === 'VES' ? totalOrig : (totalUsd * (tasa > 0 ? tasa : 1.0));
                } else if (displayCurrency === 'EUR') {
                    const vesEquiv = g.moneda === 'VES' ? totalOrig : (totalUsd * (tasa > 0 ? tasa : 1.0));
                    targetTotal = liveRates.eur > 0 ? (vesEquiv / liveRates.eur) : totalUsd;
                } else if (displayCurrency === 'USDT') {
                    targetTotal = totalUsdt;
                } else {
                    // USD
                    targetTotal = totalUsd;
                }

                const items = g.items || [];
                if (items.length === 0) {
                    catSpent[gastoCat] = (catSpent[gastoCat] || 0) + targetTotal;
                } else {
                    let sumItems = 0;
                    items.forEach(it => {
                        sumItems += (Number(it.total || 0) / 100.0);
                    });

                    items.forEach(it => {
                        const cat = normalizarCategoria(it.categoria || gastoCat);
                        const itTotal = (Number(it.total || 0) / 100.0);
                        const ratio = sumItems > 0 ? (itTotal / sumItems) : (1.0 / items.length);
                        const allocated = ratio * targetTotal;
                        catSpent[cat] = (catSpent[cat] || 0) + allocated;
                    });
                }
            });

            // Combinar con presupuestos
            const allCats = new Set([...CATEGORIAS_DEF, ...Object.keys(currentPresupuesto.categorias || {})]);

            allCats.forEach(cat => {
                const spent = catSpent[cat] || 0;
                const rawBudget = Number(currentPresupuesto.categorias[cat] || 0);
                const budget = convertBudgetToLens(rawBudget, budgetCurrency, displayCurrency);

                if (spent === 0 && budget === 0) return; // ocultar vacías no presupuestadas

                const percent = budget > 0 ? Math.round((spent / budget) * 100) : 0;
                const isOver = budget > 0 && spent > budget;
                const icon = CATEGORIA_ICONS[cat] || '🏷️';

                const row = document.createElement('div');
                row.className = "p-3 rounded-xl bg-slate-50 border border-slate-100 flex flex-col gap-2";
                row.innerHTML = `
                    <div class="flex justify-between items-center text-xs">
                        <div class="flex items-center gap-2 font-bold text-slate-800">
                            <span>${icon}</span>
                            <span>${cat}</span>
                        </div>
                        <div class="text-right">
                            <span class="font-bold text-slate-900">${formatMoney(spent, displayCurrency)}</span>
                            ${budget > 0 ? `<span class="text-slate-400"> / ${formatMoney(budget, displayCurrency)}</span>` : ''}
                        </div>
                    </div>
                    ${budget > 0 ? `
                        <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                            <div class="${isOver ? 'bg-rose-500' : 'bg-[#FACC15]'} h-1.5 rounded-full" style="width: ${Math.min(percent, 100)}%"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="${isOver ? 'text-rose-600 font-bold' : 'text-slate-500'}">${percent}% consumido</span>
                            <span class="${isOver ? 'text-rose-600 font-semibold' : 'text-slate-400'}">
                                ${isOver ? 'Excedido' : `Restan ${formatMoney(budget - spent, displayCurrency)}`}
                            </span>
                        </div>
                    ` : ''}
                `;
                categoriesList.appendChild(row);
            });

            if (categoriesList.children.length === 0) {
                categoriesList.innerHTML = `
                    <div class="text-center py-6 text-slate-400 text-xs">
                        No hay gastos ni presupuestos asignados por categoría para este mes.
                    </div>
                `;
            }
        };

        // Renderizado de Facturas (Con indicación exacta de moneda y tasa)
        const renderBills = (searchTerm = '') => {
            billsList.innerHTML = '';

            const term = (searchTerm || '').trim().toLowerCase();
            const filtered = currentGastos.filter(g => {
                if (!term) return true;
                return (g.comercio || '').toLowerCase().includes(term) || (g.categoria || '').toLowerCase().includes(term);
            });

            if (filtered.length === 0) {
                billsList.innerHTML = `
                    <div class="text-center py-12 text-slate-400 text-sm">
                        No se encontraron facturas registradas en este período.
                    </div>
                `;
                return;
            }

            filtered.forEach(gasto => {
                const totalUsd = (Number(gasto.total_usd || 0) / 100.0);
                const totalOrig = (Number(gasto.total_original || 0) / 100.0);
                const moneda = gasto.moneda || 'USD';
                const tasa = Number(gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_cambio) : (liveRates.usd || 1.0);
                const items = gasto.items || [];
                const catNorm = normalizarCategoria(gasto.categoria);
                const icon = CATEGORIA_ICONS[catNorm] || '🧾';

                let totalUsdt = 0;
                if (gasto.total_usdt !== undefined && gasto.total_usdt !== null) {
                    totalUsdt = (Number(gasto.total_usdt || 0)) / 100.0;
                } else if (moneda !== 'VES') {
                    totalUsdt = totalUsd;
                } else {
                    const tUsdt = Number(gasto.tasa_usdt || 0) > 0 ? Number(gasto.tasa_usdt) : (Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : 0);
                    totalUsdt = tUsdt > 0 ? (totalOrig / tUsdt) : totalUsd;
                }

                let secondarySubtext = '';
                if (moneda === 'VES') {
                    secondarySubtext = `≈ ${formatMoney(totalUsd, 'USD')} BCV • ${formatMoney(totalUsdt, 'USDT')}`;
                } else {
                    const equivVes = (totalUsd * tasa);
                    secondarySubtext = `≈ ${formatMoney(equivVes, 'VES')} (Tasa: Bs. ${tasa.toFixed(2)})`;
                }

                const card = document.createElement('div');
                card.className = "p-4 rounded-xl border border-slate-200 hover:border-slate-300 bg-white transition-all";
                card.innerHTML = `
                    <div class="flex justify-between items-start gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg flex-shrink-0">
                                ${icon}
                            </div>
                            <div>
                                <h4 class="font-bold text-sm text-slate-900 leading-snug">${gasto.comercio || 'Comercio'}</h4>
                                <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
                                    <span>${gasto.fecha || ''}</span>
                                    <span>•</span>
                                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium text-[10px]">${catNorm}</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="font-bold text-base text-slate-900 block">${formatMoney(totalOrig, moneda)}</span>
                            <span class="text-xs text-slate-400 block">${secondarySubtext}</span>
                        </div>
                    </div>

                    ${items.length > 0 ? `
                        <div class="mt-3 pt-3 border-t border-slate-100">
                            <details class="text-xs group">
                                <summary class="cursor-pointer font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-between">
                                    <span>Ver ${items.length} producto${items.length > 1 ? 's' : ''}</span>
                                    <span class="text-[10px] text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                                </summary>
                                <div class="mt-2 space-y-1.5 pl-2 border-l-2 border-slate-100 text-slate-600">
                                    ${items.map(it => {
                                        const unitPrice = (Number(it.precio_unitario || 0) / 100.0);
                                        const itTotal = (Number(it.total || 0) / 100.0);
                                        return `
                                            <div class="flex justify-between items-center py-0.5">
                                                <span>${it.cantidad || 1}x ${it.descripcion || 'Producto'}</span>
                                                <span class="font-mono text-slate-800">${formatMoney(itTotal, gasto.moneda || 'USD')}</span>
                                            </div>
                                        `;
                                    }).join('')}
                                </div>
                            </details>
                        </div>
                    ` : ''}

                    <div class="mt-3 pt-2 border-t border-slate-100 flex justify-end gap-3">
                        <button class="btn-edit-expense text-[11px] font-semibold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-1" data-id="${gasto.id}">
                            ✏️ Editar
                        </button>
                        <button class="btn-delete-expense text-[11px] font-semibold text-slate-400 hover:text-rose-600 transition-colors" data-id="${gasto.id}">
                            Eliminar factura
                        </button>
                    </div>
                `;

                // Listener para editar
                card.querySelector('.btn-edit-expense')?.addEventListener('click', (e) => {
                    const id = (e.currentTarget).getAttribute('data-id');
                    const targetGasto = currentGastos.find(g => g.id === id);
                    if (targetGasto) {
                        openEditExpenseModal(targetGasto);
                    }
                });

                // Listener para eliminar
                card.querySelector('.btn-delete-expense')?.addEventListener('click', async (e) => {
                    const id = (e.currentTarget).getAttribute('data-id');
                    if (confirm("¿Deseas descartar esta factura? Se eliminará de tu cuenta y se sincronizará con tu teléfono.")) {
                        try {
                            const docRef = doc(db, 'users', currentUser.uid, 'gastos', id);
                            await updateDoc(docRef, {
                                eliminado_en: new Date().toISOString()
                            });
                            await loadDashboardData();
                        } catch (err) {
                            console.error("Error al eliminar gasto:", err);
                            alert("No se pudo eliminar la factura.");
                        }
                    }
                });

                billsList.appendChild(card);
            });
        };

        searchBills?.addEventListener('input', (e) => {
            renderBills(e.target.value);
        });

        // ==========================================
        // Lógica de Modales
        // ==========================================

        // Modal Presupuesto (con memoria base anti-deriva)
        let baseBudgetGeneral = null;
        let baseBudgetSavings = null;
        let baseBudgetCats = {};
        let baseBudgetCurrency = 'USD';
        let currentModalBudgetCurrency = 'USD';

        const convertBudgetAmount = (val, from, to) => {
            if (!val || val <= 0) return '';
            if (from === to) return val % 1 === 0 ? val.toString() : val.toFixed(2);
            if ((from === 'USD' && to === 'USDT') || (from === 'USDT' && to === 'USD')) {
                return val % 1 === 0 ? val.toString() : val.toFixed(2);
            }
            const effFrom = (from === 'USDT') ? 'USD' : from;
            const effTo = (to === 'USDT') ? 'USD' : to;
            if (effFrom === effTo) return val % 1 === 0 ? val.toString() : val.toFixed(2);

            const toVes = (v, m) => {
                if (m === 'VES') return v;
                if (m === 'EUR') return v * (liveRates.eur > 0 ? liveRates.eur : (liveRates.usd > 0 ? liveRates.usd : 1.0));
                return v * (liveRates.usd > 0 ? liveRates.usd : 1.0);
            };

            const fromVes = (ves, m) => {
                if (m === 'VES') return ves;
                if (m === 'EUR') {
                    const r = liveRates.eur > 0 ? liveRates.eur : (liveRates.usd > 0 ? liveRates.usd : 1.0);
                    return r > 0 ? ves / r : ves;
                }
                const r = liveRates.usd > 0 ? liveRates.usd : 1.0;
                return r > 0 ? ves / r : ves;
            };

            const ves = toVes(val, effFrom);
            const converted = fromVes(ves, effTo);
            return converted >= 100 ? Math.round(converted).toString() : converted.toFixed(2);
        };

        const openBudgetModal = () => {
            currentModalBudgetCurrency = currentPresupuesto.moneda || 'USD';
            baseBudgetCurrency = currentModalBudgetCurrency;
            baseBudgetGeneral = currentPresupuesto.general > 0 ? currentPresupuesto.general : null;
            baseBudgetSavings = currentPresupuesto.meta_ahorro > 0 ? currentPresupuesto.meta_ahorro : null;
            baseBudgetCats = { ...(currentPresupuesto.categorias || {}) };

            modalBudgetCurrency.value = currentModalBudgetCurrency;
            modalBudgetGeneral.value = currentPresupuesto.general > 0 ? currentPresupuesto.general.toString() : '';
            modalBudgetSavings.value = currentPresupuesto.meta_ahorro > 0 ? currentPresupuesto.meta_ahorro.toString() : '';

            modalBudgetCategoriesInputs.innerHTML = '';
            CATEGORIAS_DEF.forEach(cat => {
                const existingVal = currentPresupuesto.categorias[cat] || '';
                const row = document.createElement('div');
                row.className = "flex items-center justify-between gap-3";
                row.innerHTML = `
                    <span class="text-xs text-slate-700 font-medium flex items-center gap-1.5 w-32 truncate">
                        <span>${CATEGORIA_ICONS[cat] || '🏷️'}</span>
                        <span>${cat}</span>
                    </span>
                    <input 
                        type="number" 
                        step="0.01" 
                        min="0" 
                        data-cat="${cat}" 
                        value="${existingVal}" 
                        placeholder="0.00" 
                        class="input-cat-budget flex-1 px-2.5 py-1.5 text-xs rounded-xl border border-slate-200 text-slate-800 focus:outline-none focus:ring-1 focus:ring-[#FACC15]"
                    />
                `;
                modalBudgetCategoriesInputs.appendChild(row);
            });

            updateBudgetSumIndicator();
            modalBudget.classList.remove('hidden');
            modalBudget.classList.add('flex');
        };

        const closeBudgetModal = () => {
            modalBudget.classList.add('hidden');
            modalBudget.classList.remove('flex');
        };

        const updateBudgetSumIndicator = () => {
            let sum = 0;
            const inputs = document.querySelectorAll('.input-cat-budget');
            inputs.forEach(inp => {
                sum += Number((inp).value || 0);
            });
            const gen = Number(modalBudgetGeneral.value || 0);
            const meta = Number(modalBudgetSavings.value || 0);
            const curr = modalBudgetCurrency.value;

            // Validación visual de la meta de ahorro
            if (gen > 0 && meta > gen) {
                modalBudgetLimitIndicator.classList.remove('hidden');
                modalBudgetLimitIndicator.className = "text-[11px] font-bold text-rose-600";
                modalBudgetLimitIndicator.textContent = "La meta supera el presupuesto general";
            } else if (meta > 0 && meta <= gen) {
                const limiteParaGastar = gen - meta;
                modalBudgetLimitIndicator.classList.remove('hidden');
                modalBudgetLimitIndicator.className = "text-[11px] font-bold text-emerald-600";
                modalBudgetLimitIndicator.textContent = `Límite para gastar: ${formatMoney(limiteParaGastar, curr)}`;
            } else {
                modalBudgetLimitIndicator.classList.add('hidden');
            }

            // Límite aplicable a categorías
            const limiteReal = meta > 0 ? Math.max(0, gen - meta) : gen;
            modalBudgetSumIndicator.textContent = `Suma: ${formatMoney(sum, curr)}`;

            if (gen > 0 && meta > gen) {
                modalBudgetSumIndicator.className = "text-xs font-bold text-rose-600";
                modalBudgetSumIndicator.textContent = `Suma: ${formatMoney(sum, curr)} (Corrige la meta de ahorro)`;
            } else if (gen > 0 && sum > limiteReal) {
                modalBudgetSumIndicator.className = "text-xs font-bold text-rose-600";
                modalBudgetSumIndicator.textContent = `Suma: ${formatMoney(sum, curr)} (${meta > 0 ? 'Supera el límite para gastar' : 'Supera el general'})`;
            } else {
                modalBudgetSumIndicator.className = "text-xs text-slate-500 font-medium";
            }
        };

        btnOpenBudgetModal?.addEventListener('click', openBudgetModal);
        btnEditCategories?.addEventListener('click', openBudgetModal);
        btnCloseBudgetModal?.addEventListener('click', closeBudgetModal);
        btnCancelBudgetModal?.addEventListener('click', closeBudgetModal);

        modalBudgetGeneral?.addEventListener('input', () => {
            baseBudgetGeneral = Number(modalBudgetGeneral.value) || null;
            baseBudgetCurrency = modalBudgetCurrency.value;
            updateBudgetSumIndicator();
        });
        modalBudgetSavings?.addEventListener('input', () => {
            baseBudgetSavings = Number(modalBudgetSavings.value) || null;
            baseBudgetCurrency = modalBudgetCurrency.value;
            updateBudgetSumIndicator();
        });
        modalBudgetCategoriesInputs?.addEventListener('input', (e) => {
            const target = e.target;
            if (target && target.classList.contains('input-cat-budget')) {
                const cat = target.getAttribute('data-cat');
                if (cat) {
                    baseBudgetCats[cat] = Number(target.value) || null;
                    baseBudgetCurrency = modalBudgetCurrency.value;
                }
            }
            updateBudgetSumIndicator();
        });

        modalBudgetCurrency?.addEventListener('change', () => {
            const newCur = modalBudgetCurrency.value;
            if (newCur === currentModalBudgetCurrency) return;

            if (baseBudgetGeneral !== null && baseBudgetGeneral > 0) {
                modalBudgetGeneral.value = (newCur === baseBudgetCurrency)
                    ? (baseBudgetGeneral % 1 === 0 ? baseBudgetGeneral.toString() : baseBudgetGeneral.toFixed(2))
                    : convertBudgetAmount(baseBudgetGeneral, baseBudgetCurrency, newCur);
            }
            if (baseBudgetSavings !== null && baseBudgetSavings > 0) {
                modalBudgetSavings.value = (newCur === baseBudgetCurrency)
                    ? (baseBudgetSavings % 1 === 0 ? baseBudgetSavings.toString() : baseBudgetSavings.toFixed(2))
                    : convertBudgetAmount(baseBudgetSavings, baseBudgetCurrency, newCur);
            }
            const inputs = document.querySelectorAll('.input-cat-budget');
            inputs.forEach(inp => {
                const c = inp.getAttribute('data-cat');
                const baseVal = c ? baseBudgetCats[c] : null;
                if (baseVal !== null && baseVal !== undefined && baseVal > 0) {
                    inp.value = (newCur === baseBudgetCurrency)
                        ? (baseVal % 1 === 0 ? baseVal.toString() : baseVal.toFixed(2))
                        : convertBudgetAmount(baseVal, baseBudgetCurrency, newCur);
                }
            });

            currentModalBudgetCurrency = newCur;
            updateBudgetSumIndicator();
        });

        btnSaveBudgetModal?.addEventListener('click', async () => {
            if (!currentUser) return;

            const general = Number(modalBudgetGeneral.value || 0);
            const metaAhorro = Number(modalBudgetSavings.value || 0);
            const moneda = modalBudgetCurrency.value;
            const cats = {};

            let sum = 0;
            const inputs = document.querySelectorAll('.input-cat-budget');
            inputs.forEach(inp => {
                const c = (inp).getAttribute('data-cat');
                const val = Number((inp).value || 0);
                if (val > 0 && c) {
                    cats[c] = val;
                    sum += val;
                }
            });

            if (general > 0 && metaAhorro > general) {
                alert("La meta de ahorro no puede superar el presupuesto general.");
                return;
            }

            const limiteReal = metaAhorro > 0 ? Math.max(0, general - metaAhorro) : general;
            if (general > 0 && sum > limiteReal) {
                alert(metaAhorro > 0
                    ? `La suma de las categorías (${formatMoney(sum, moneda)}) supera el límite para gastar (${formatMoney(limiteReal, moneda)}). Ajusta los montos.`
                    : "La suma de las categorías no puede superar el presupuesto general."
                );
                return;
            }

            const docId = getDocId(selectedYear, selectedMonth);
            const budgetRef = doc(db, 'users', currentUser.uid, 'presupuestos', docId);

            try {
                btnSaveBudgetModal.textContent = "Guardando...";
                await setDoc(budgetRef, {
                    anio: selectedYear,
                    mes: selectedMonth,
                    presupuesto_general: general,
                    meta_ahorro: metaAhorro,
                    moneda: moneda,
                    categorias: cats,
                    actualizado_en: new Date().toISOString()
                }, { merge: true });

                closeBudgetModal();
                await loadDashboardData();
            } catch (err) {
                console.error("Error al guardar presupuesto:", err);
                alert("No se pudo guardar el presupuesto.");
            } finally {
                btnSaveBudgetModal.textContent = "Guardar";
            }
        });

        // Modal Registrar Gasto con Ítems (Mismo flujo que la app móvil)
        let modalExpenseItems = [];
        let expMoneda = 'USD';

        const renderExpenseItems = () => {
            if (!modalExpItemsList) return;
            modalExpItemsList.innerHTML = '';

            if (itemsCountBadge) {
                itemsCountBadge.textContent = `${modalExpenseItems.length} ítem${modalExpenseItems.length === 1 ? '' : 's'}`;
            }

            if (modalExpenseItems.length === 0) {
                modalExpItemsList.innerHTML = `
                    <div class="text-center py-4 text-slate-400 text-xs bg-white rounded-xl border border-slate-200">
                        No hay ítems detallados. Puedes ingresar el monto total directamente o desglosarlos con el botón de abajo.
                    </div>
                `;
                return;
            }

            modalExpenseItems.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = "bg-white border border-slate-200 rounded-xl p-3 space-y-2.5 shadow-sm";
                card.innerHTML = `
                    <!-- Fila 1: Descripción + Botón Eliminar -->
                    <div class="flex items-center gap-2">
                        <input 
                            type="text" 
                            placeholder="Descripción del Producto" 
                            value="${item.descripcion || ''}" 
                            class="item-input-desc flex-1 px-3 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-1 focus:ring-[#FACC15] text-slate-900"
                        />
                        <button 
                            type="button" 
                            class="btn-remove-item text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-slate-50 transition-colors text-xs" 
                            title="Eliminar producto"
                        >
                            🗑️
                        </button>
                    </div>

                    <!-- Fila 2: Cantidad, Precio, Total -->
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Cant.</label>
                            <input 
                                type="number" 
                                step="1" 
                                min="0.01" 
                                value="${item.cantidad || 1}" 
                                class="item-input-cant w-full px-2.5 py-1 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-1 focus:ring-[#FACC15] text-slate-900"
                            />
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Precio</label>
                            <input 
                                type="number" 
                                step="0.01" 
                                min="0" 
                                placeholder="0.00" 
                                value="${item.precio !== '' ? item.precio : ''}" 
                                class="item-input-precio w-full px-2.5 py-1 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-1 focus:ring-[#FACC15] text-slate-900"
                            />
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Total</label>
                            <input 
                                type="number" 
                                step="0.01" 
                                min="0" 
                                placeholder="0.00" 
                                value="${item.total !== '' ? item.total : ''}" 
                                class="item-input-total w-full px-2.5 py-1 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-1 focus:ring-[#FACC15] text-slate-900 font-semibold"
                            />
                        </div>
                    </div>

                    <!-- Fila 3: Categoría -->
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Categoría</label>
                        <select class="item-input-cat w-full px-2.5 py-1 text-xs rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-1 focus:ring-[#FACC15]">
                            ${CATEGORIAS_DEF.map(c => `
                                <option value="${c}" ${c === normalizarCategoria(item.categoria || 'Otros') ? 'selected' : ''}>
                                    ${CATEGORIA_ICONS[c] || '🏷️'} ${c}
                                </option>
                            `).join('')}
                        </select>
                    </div>
                `;

                // Listeners del ítem
                const inputDesc = card.querySelector('.item-input-desc');
                const inputCant = card.querySelector('.item-input-cant');
                const inputPrecio = card.querySelector('.item-input-precio');
                const inputTotal = card.querySelector('.item-input-total');
                const inputCat = card.querySelector('.item-input-cat');
                const btnRemove = card.querySelector('.btn-remove-item');

                inputDesc.addEventListener('input', (e) => {
                    item.descripcion = e.target.value;
                });

                inputCat.addEventListener('change', (e) => {
                    item.categoria = e.target.value;
                });

                const recalcItem = () => {
                    const cant = Number(inputCant.value) || 1;
                    const precio = Number(inputPrecio.value) || 0;
                    item.cantidad = cant;
                    item.precio = inputPrecio.value;
                    if (precio > 0) {
                        const tot = (cant * precio).toFixed(2);
                        item.total = tot;
                        inputTotal.value = tot;
                    }
                    recalculateGrandTotal();
                };

                inputCant.addEventListener('input', recalcItem);
                inputPrecio.addEventListener('input', recalcItem);

                inputTotal.addEventListener('input', (e) => {
                    item.total = e.target.value;
                    recalculateGrandTotal();
                });

                btnRemove.addEventListener('click', () => {
                    modalExpenseItems.splice(index, 1);
                    renderExpenseItems();
                    recalculateGrandTotal();
                });

                modalExpItemsList.appendChild(card);
            });
        };

        const recalculateGrandTotal = () => {
            if (modalExpenseItems.length > 0) {
                const sum = modalExpenseItems.reduce((acc, it) => acc + (Number(it.total) || 0), 0);
                if (sum > 0) {
                    modalExpTotal.value = sum.toFixed(2);
                }
            }
            updateCurrencyDisplay();
        };

        const setCurrencyButtonActive = (activeBtn) => {
            const buttons = [btnCurrencyUsd, btnCurrencyVes, btnCurrencyEur, btnCurrencyUsdt];
            buttons.forEach(btn => {
                if (!btn) return;
                if (btn === activeBtn) {
                    btn.className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm";
                } else {
                    btn.className = "flex-1 py-1.5 text-xs font-medium rounded-lg text-slate-600 hover:text-slate-900 transition-all";
                }
            });
        };

        const updateLiquidationDisplay = () => {
            const buttons = [
                { btn: document.getElementById('btn-liq-bcv'), liq: 'BS_BCV' },
                { btn: document.getElementById('btn-liq-usdt'), liq: 'BS_USDT' },
                { btn: document.getElementById('btn-liq-divisa'), liq: 'DIVISA' }
            ];
            buttons.forEach(({ btn, liq }) => {
                if (!btn) return;
                if (liq === selectedLiq) {
                    btn.className = "btn-liq-opt flex flex-col items-start p-2.5 rounded-xl border-2 border-[#FACC15] bg-amber-50/50 shadow-sm transition-all text-left";
                } else {
                    btn.className = "btn-liq-opt flex flex-col items-start p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-all text-left";
                }
            });

            const preview = document.getElementById('liq-preview-card');
            if (!preview) return;
            const currentTasa = Number(modalExpTasa?.value) || getRateForCurrency(expMoneda) || 1;
            const tasaUsdt = Number(liveRates.usdt || 0) > 0 ? Number(liveRates.usdt) : currentTasa;
            const total = Number(modalExpTotal?.value) || 0;

            if (selectedLiq === 'BS_BCV') {
                const autoBs = total * currentTasa;
                const existingBsInput = document.getElementById('modal-exp-bs-final');
                const bsVal = (bolivaresAjustadosManualmente && existingBsInput && existingBsInput.value)
                    ? Number(existingBsInput.value)
                    : autoBs;
                const totalUsdtEquiv = tasaUsdt > 0 ? (bsVal / tasaUsdt) : total;

                preview.innerHTML = `
                    <div class="space-y-2">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-800">Liquidación en Bolívares (Tasa BCV: Bs. ${currentTasa.toFixed(2)})</span>
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-700 mb-1">Total a pagar en Bolívares (VES)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-500 font-bold text-xs">Bs.</span>
                                <input 
                                    id="modal-exp-bs-final" 
                                    type="number" 
                                    step="0.01" 
                                    min="0" 
                                    value="${bsVal > 0 ? bsVal.toFixed(2) : ''}" 
                                    class="w-full pl-9 pr-3 py-1.5 text-sm font-bold text-slate-900 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#FACC15] focus:outline-none" 
                                    placeholder="0.00"
                                />
                            </div>
                            <span class="text-[10px] text-slate-400 mt-0.5 block">Ajustable por redondeo comercial en punto de venta</span>
                        </div>
                        <div class="text-[10px] text-slate-500">
                            Equivale a: <strong id="lbl-liq-equiv" class="text-slate-700">${formatMoney(totalUsdtEquiv, 'USDT')}</strong> (a tasa P2P Bs. ${tasaUsdt.toFixed(2)})
                        </div>
                    </div>
                `;

                const bsInput = document.getElementById('modal-exp-bs-final');
                bsInput?.addEventListener('input', (e) => {
                    bolivaresAjustadosManualmente = true;
                    const val = Number(e.target.value) || 0;
                    const equiv = tasaUsdt > 0 ? (val / tasaUsdt) : 0;
                    const equivLabel = document.getElementById('lbl-liq-equiv');
                    if (equivLabel) equivLabel.textContent = formatMoney(equiv, 'USDT');
                });
            } else if (selectedLiq === 'BS_USDT') {
                const autoBs = total * tasaUsdt;
                const existingBsInput = document.getElementById('modal-exp-bs-final');
                const bsVal = (bolivaresAjustadosManualmente && existingBsInput && existingBsInput.value)
                    ? Number(existingBsInput.value)
                    : autoBs;
                const totalUsdEquiv = currentTasa > 0 ? (bsVal / currentTasa) : total;

                preview.innerHTML = `
                    <div class="space-y-2">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-800">Liquidación en Bolívares (Tasa P2P: Bs. ${tasaUsdt.toFixed(2)})</span>
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-700 mb-1">Total a pagar en Bolívares (VES)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-500 font-bold text-xs">Bs.</span>
                                <input 
                                    id="modal-exp-bs-final" 
                                    type="number" 
                                    step="0.01" 
                                    min="0" 
                                    value="${bsVal > 0 ? bsVal.toFixed(2) : ''}" 
                                    class="w-full pl-9 pr-3 py-1.5 text-sm font-bold text-slate-900 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-[#FACC15] focus:outline-none" 
                                    placeholder="0.00"
                                />
                            </div>
                            <span class="text-[10px] text-slate-400 mt-0.5 block">Ajustable por redondeo comercial en punto de venta</span>
                        </div>
                        <div class="text-[10px] text-slate-500">
                            Equivale a: <strong id="lbl-liq-equiv" class="text-slate-700">${formatMoney(totalUsdEquiv, 'USD')}</strong> (a tasa BCV Bs. ${currentTasa.toFixed(2)})
                        </div>
                    </div>
                `;

                const bsInput = document.getElementById('modal-exp-bs-final');
                bsInput?.addEventListener('input', (e) => {
                    bolivaresAjustadosManualmente = true;
                    const val = Number(e.target.value) || 0;
                    const equiv = currentTasa > 0 ? (val / currentTasa) : 0;
                    const equivLabel = document.getElementById('lbl-liq-equiv');
                    if (equivLabel) equivLabel.textContent = formatMoney(equiv, 'USD');
                });
            } else {
                preview.innerHTML = `
                    <div class="py-1 text-slate-600">
                        Monto pagado directamente en divisas (efectivo, Zelle o tarjeta internacional). Total: <strong class="text-slate-800">${formatMoney(total, expMoneda)}</strong>.
                    </div>
