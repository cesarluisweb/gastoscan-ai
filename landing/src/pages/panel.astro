                                    <span>${escapeHtml(gasto.fecha || '')}</span>
                                    <span>•</span>
                                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium text-[10px]">${escapeHtml(catNorm)}</span>
                                </div>
                                ${gasto.notas ? `<p class="text-[11px] text-slate-500 mt-1">${escapeHtml(gasto.notas)}</p>` : ''}
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="font-bold text-base text-slate-900 block">${escapeHtml(formatMoney(targetTotalLens, displayCurrency))}</span>
                            <span class="text-xs text-slate-400 block">${escapeHtml(secondarySubtext)}</span>
                        </div>
                    </div>

                    ${items.length > 0 ? `
                        <div class="mt-3 pt-3 border-t border-slate-100">
                            <details class="text-xs group">
                                <summary class="cursor-pointer font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-between">
                                    <span>Ver ${items.length} producto${items.length > 1 ? 's' : ''}</span>
                                    <span class="text-[10px] text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                                </summary>
                                <div class="mt-2 space-y-1.5 pl-2 border-l-2 border-slate-100 text-slate-600">
                                    ${items.map(it => {
                                        const itTotal = (Number(it.total || 0) / 100.0);
                                        const ratio = totalOrig > 0 ? (itTotal / totalOrig) : 0;
                                        const itAmountLens = ratio > 0 ? (targetTotalLens * ratio) : itTotal;
                                        const itAmountUsd = ratio > 0 ? (totalUsd * ratio) : (moneda === 'VES' ? (tasa > 0 ? itTotal / tasa : itTotal) : itTotal);
                                        const itAmountVes = moneda === 'VES' ? itTotal : (itAmountUsd * tasa);

                                        const isVesLens = displayCurrency === 'VES';
                                        const itSecAmount = isVesLens ? itAmountUsd : itAmountVes;
                                        const itSecCurrency = isVesLens ? 'USD' : 'VES';

                                        const cleanDesc = String(it.descripcion || 'Producto').replace(/\s*\(\s*[EeGg]\s*\)\s*$/g, '').trim() || 'Producto';
                                        const cant = Number(it.cantidad || 1);
                                        const cantStr = Number.isInteger(cant) ? cant.toString() : cant.toFixed(2);

                                        let unitSubtext = '';
                                        if (cant > 1) {
                                            const unitLens = itAmountLens / cant;
                                            const unitSec = itSecAmount / cant;
                                            unitSubtext = `${cantStr}x a ${formatMoney(unitLens, displayCurrency)} (${formatMoney(unitSec, itSecCurrency)}) c/u`;
                                        }

                                        return `
                                            <div class="flex justify-between items-center py-1 gap-2">
                                                <div class="min-w-0 pr-2">
                                                    <div class="truncate text-xs text-slate-700 font-medium">${cantStr}x ${escapeHtml(cleanDesc)}</div>
                                                    ${unitSubtext ? `<div class="text-[10px] text-slate-400 font-medium">${escapeHtml(unitSubtext)}</div>` : ''}
                                                </div>
                                                <div class="text-right flex-shrink-0">
                                                    <span class="font-mono font-semibold text-xs text-slate-800 block">${escapeHtml(formatMoney(itAmountLens, displayCurrency))}</span>
                                                    <span class="font-mono text-[10px] text-slate-400 block">${escapeHtml(formatMoney(itSecAmount, itSecCurrency))}</span>
                                                </div>
