        const containerFormaPago = document.getElementById('container-forma-pago');
        const btnLiqDivisa = document.getElementById('btn-liq-divisa');
        const btnLiqBcv = document.getElementById('btn-liq-bcv');
        const btnLiqUsdt = document.getElementById('btn-liq-usdt');
        const containerLiqBsDetails = document.getElementById('container-liq-bs-details');
        const lblLiqRateDesc = document.getElementById('lbl-liq-rate-desc');
        const btnToggleLiqRate = document.getElementById('btn-toggle-liq-rate');
        const btnToggleLiqRateIcon = document.getElementById('btn-toggle-liq-rate-icon');
        const containerLiqRateInput = document.getElementById('container-liq-rate-input');
        const btnRestoreLiqRate = document.getElementById('btn-restore-liq-rate');
        const modalExpBsFinal = document.getElementById('modal-exp-bs-final');
        const containerLiqDivisaBanner = document.getElementById('container-liq-divisa-banner');
        const lblLiqDivisaBannerText = document.getElementById('lbl-liq-divisa-banner-text');

        const modalDiscrepancyDecision = document.getElementById('modal-discrepancy-decision');
        const modalDiscrepancyDesc = document.getElementById('modal-discrepancy-desc');
        const btnDiscrepancyAdjust = document.getElementById('btn-discrepancy-adjust');
        const btnDiscrepancyKeep = document.getElementById('btn-discrepancy-keep');
        const btnDiscrepancyCancel = document.getElementById('btn-discrepancy-cancel');

        const getCurrencySymbol = (cur) => {
            switch ((cur || 'USD').toUpperCase()) {
                case 'VES': return 'Bs.';
                case 'EUR': return '€';
                case 'USDT': return 'USDT';
                case 'USD':
                default: return '$';
            }
        };

        const getItemsSum = () => {
            return modalExpenseItems.reduce((acc, it) => {
                const cant = Number(it.cantidad) || 1;
                const pr = Number(it.precio) || 0;
                const tot = it.total !== '' && it.total !== undefined ? Number(it.total) : (cant * pr);
                return acc + (tot || 0);
            }, 0);
        };

        const checkDiscrepancy = () => {
            if (!modalExpDiscrepancyBanner) return;
            const sum = getItemsSum();
            const grandTotal = Number(modalExpTotal?.value || 0);
            const diff = Math.abs(sum - grandTotal);
            const hasItems = modalExpenseItems.length > 0 && modalExpenseItems.some(it => (it.descripcion || '').trim() || (Number(it.precio) || 0) > 0);

            if (hasItems && sum > 0 && grandTotal > 0 && diff > 0.05) {
                modalExpDiscrepancyBanner.classList.remove('hidden');
                if (modalExpDiscrepancyText) {
                    modalExpDiscrepancyText.textContent = `La suma de los artículos (${formatMoney(sum, expMoneda)}) no coincide con el total (${formatMoney(grandTotal, expMoneda)}). Diferencia: ${formatMoney(diff, expMoneda)}.`;
                }
            } else {
                modalExpDiscrepancyBanner.classList.add('hidden');
            }
        };

        const tryAutoSumItems = () => {
            if (!totalEditadoManualmente && modalExpenseItems.length > 0) {
                const sum = getItemsSum();
                if (sum > 0 && modalExpTotal) {
                    modalExpTotal.value = sum.toFixed(2);
                    bolivaresAjustadosManualmente = false;
                }
            }
            checkDiscrepancy();
            updateCurrencyDisplay();
        };

        const renderExpenseItems = () => {
            if (!modalExpItemsList) return;
            modalExpItemsList.innerHTML = '';

            if (modalExpItemsTitle) {
                modalExpItemsTitle.textContent = modalExpenseItems.length > 1
                    ? `¿En qué gastaste? (${modalExpenseItems.length} artículos)`
                    : '¿En qué gastaste?';
            }
            if (btnAddItemText) {
                btnAddItemText.textContent = modalExpenseItems.length === 0
                    ? 'Agregar artículo'
                    : 'Agregar otro artículo';
            }
            if (modalExpItemsMonedaLabel) {
                modalExpItemsMonedaLabel.textContent = `Precios en ${getCurrencySymbol(expMoneda)}`;
            }

            if (modalExpenseItems.length === 0) {
                modalExpItemsList.innerHTML = `
                    <div class="text-center py-4 text-slate-400 text-xs bg-white rounded-xl border border-slate-200">
                        Sin artículos detallados. Puedes ingresar el monto total directamente o agregar productos.
                    </div>
                `;
                checkDiscrepancy();
                return;
            }

            modalExpenseItems.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = "bg-white border border-slate-200 rounded-xl p-3.5 space-y-2.5 shadow-sm";
                card.innerHTML = `
                    <!-- Fila 1: Concepto + Botón Eliminar -->
                    <div class="flex items-center gap-2">
                        <input 
                            type="text" 
                            placeholder="Ej. Harina PAN, Taxi..." 
                            value="${escapeHtml(item.descripcion || '')}" 
                            class="item-input-desc flex-1 px-3 py-2 text-xs sm:text-sm rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#FACC15] text-slate-900"
                        />
                        ${modalExpenseItems.length > 1 ? `
                            <button 
                                type="button" 
                                class="btn-remove-item text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-slate-50 transition-colors text-base" 
                                title="Eliminar artículo"
                            >
                                🗑️
                            </button>
                        ` : ''}
                    </div>

                    <!-- Fila 2: Cantidad (35%) y Precio (65%) -->
                    <div class="flex gap-2">
                        <div class="w-[35%]">
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Cant.</label>
                            <input 
                                type="number" 
                                inputmode="decimal"
                                step="any" 
                                min="0.01" 
                                value="${escapeHtml(item.cantidad || 1)}" 
                                class="item-input-cant w-full px-2.5 py-1.5 text-xs sm:text-sm rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#FACC15] text-slate-900"
                            />
                        </div>
                        <div class="w-[65%]">
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Precio</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-500 font-semibold text-xs sm:text-sm">${escapeHtml(getCurrencySymbol(expMoneda))}</span>
                                <input 
                                    type="number" 
                                    inputmode="decimal"
                                    step="0.01" 
                                    min="0" 
                                    placeholder="0.00" 
                                    value="${escapeHtml(item.precio !== '' && item.precio !== undefined ? item.precio : '')}" 
                                    class="item-input-precio w-full pl-8 pr-2.5 py-1.5 text-xs sm:text-sm rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#FACC15] text-slate-900 font-semibold"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Fila 3: Categoría (65%) y Total calculado (35%) -->
                    <div class="flex items-center gap-2 pt-0.5">
                        <div class="w-[65%]">
                            <label class="block text-[10px] font-semibold text-slate-500 mb-0.5">Categoría</label>
                            <select class="item-input-cat w-full px-2.5 py-1.5 text-xs rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#FACC15]">
                                ${CATEGORIAS_DEF.map(c => `
                                    <option value="${escapeHtml(c)}" ${c === normalizarCategoria(item.categoria || 'Otros') ? 'selected' : ''}>
                                        ${escapeHtml(CATEGORIA_ICONS[c] || '🏷️')} ${escapeHtml(c)}
                                    </option>
                                `).join('')}
                            </select>
                        </div>
                        <div class="w-[35%] text-right">
                            <span class="block text-[10px] font-semibold text-slate-500 mb-0.5">Total</span>
                            <span class="item-label-total block font-bold text-xs sm:text-sm text-slate-900 truncate">
                                ${formatMoney(Number(item.total || ((Number(item.cantidad) || 1) * (Number(item.precio) || 0))), expMoneda)}
                            </span>
                        </div>
                    </div>
                    <p class="item-price-comparison hidden pt-1 pl-0.5 text-[11px] font-semibold leading-snug"></p>
                `;

                const inputDesc = card.querySelector('.item-input-desc');
                const inputCant = card.querySelector('.item-input-cant');
                const inputPrecio = card.querySelector('.item-input-precio');
                const inputCat = card.querySelector('.item-input-cat');
                const lblTotal = card.querySelector('.item-label-total');
                const lblComparison = card.querySelector('.item-price-comparison');
                const btnRemove = card.querySelector('.btn-remove-item');

                const updateComparisonLine = () => {
                    if (!lblComparison) return;
                    const norm = normalizeProductText(item.descripcion || '');
                    if (norm.length <= 2) {
                        lblComparison.textContent = '';
                        lblComparison.className = 'item-price-comparison hidden pt-1 pl-0.5 text-[11px] font-semibold leading-snug';
                        return;
                    }
                    const cant = Number(item.cantidad) > 0 ? Number(item.cantidad) : 1;
                    const unitPrice = Number(item.precio) || 0;
                    const tasaUsd = activeRates.usd > 0 ? activeRates.usd : 1.0;
                    const currentUnitUsd = expMoneda === 'VES' ? (unitPrice / tasaUsd) : unitPrice;
                    const comercioActual = modalExpComercio?.value || '';

                    const historyMap = findPriceHistoryFromGastos(allUserGastos, [norm], {
                        excludeGastoId: editingGastoId,
                        comercioActual,
                    });
                    const verdict = evaluatePriceComparison({
                        currentUnitUsd,
                        history: historyMap[norm],
                        comercioActual,
                    });

                    if (!verdict) {
                        lblComparison.textContent = '';
                        lblComparison.className = 'item-price-comparison hidden pt-1 pl-0.5 text-[11px] font-semibold leading-snug';
                        return;
                    }

                    lblComparison.textContent = verdict.text;
                    const colorClass = verdict.tone === 'error'
                        ? 'text-rose-600 font-semibold'
                        : verdict.tone === 'good'
                            ? 'text-slate-900 font-semibold'
                            : 'text-slate-500 font-medium';
                    lblComparison.className = `item-price-comparison block pt-1 pl-0.5 text-[11px] leading-snug ${colorClass}`;
                };

                let descDebounce = null;
                inputDesc?.addEventListener('input', (e) => {
                    item.descripcion = e.target.value;
                    if (!item.categoriaManual && !isTaxDescription(item.descripcion)) {
                        const sugerida = clasificarCategoria(item.descripcion);
                        if (sugerida && sugerida !== item.categoria) {
                            item.categoria = sugerida;
                            if (inputCat) inputCat.value = sugerida;
                        } else if (!sugerida && item.descripcion.trim().length === 0) {
                            item.categoria = 'Otros';
                            if (inputCat) inputCat.value = 'Otros';
                        }
                    }
                    tryAutoSumItems();
                    if (descDebounce) clearTimeout(descDebounce);
                    descDebounce = setTimeout(updateComparisonLine, 400);
                });

                inputCat?.addEventListener('change', (e) => {
                    item.categoria = e.target.value;
                    item.categoriaManual = true;
                    tryAutoSumItems();
                });

                const recalcItem = () => {
                    const cant = Number(inputCant.value) || 1;
                    const precio = Number(inputPrecio.value) || 0;
                    item.cantidad = cant;
                    item.precio = inputPrecio.value;
                    const tot = (cant * precio);
                    item.total = tot > 0 ? tot.toFixed(2) : '';
                    if (lblTotal) {
                        lblTotal.textContent = formatMoney(tot, expMoneda);
                    }
                    tryAutoSumItems();
                    updateComparisonLine();
                };

                inputCant?.addEventListener('input', recalcItem);
                inputPrecio?.addEventListener('input', recalcItem);

                btnRemove?.addEventListener('click', () => {
                    modalExpenseItems.splice(index, 1);
                    renderExpenseItems();
                    tryAutoSumItems();
                });

                updateComparisonLine();
                card._updateComparisonLine = updateComparisonLine;
                modalExpItemsList.appendChild(card);
            });

            checkDiscrepancy();
        };

        let comercioComparisonDebounce = null;
        modalExpComercio?.addEventListener('input', () => {
            if (comercioComparisonDebounce) clearTimeout(comercioComparisonDebounce);
            comercioComparisonDebounce = setTimeout(() => {
                if (!modalExpItemsList) return;
                modalExpItemsList.querySelectorAll(':scope > div').forEach((cardEl) => {
                    if (typeof cardEl._updateComparisonLine === 'function') {
                        cardEl._updateComparisonLine();
                    }
                });
            }, 400);
        });

        const setCurrencyButtonActive = (activeBtn) => {
            const buttons = [btnCurrencyUsd, btnCurrencyVes, btnCurrencyUsdt, btnCurrencyEur];
            buttons.forEach(btn => {
                if (!btn) return;
                if (btn === activeBtn) {
                    btn.className = "flex-1 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm";
                } else {
                    btn.className = "flex-1 py-1.5 text-xs font-medium rounded-lg text-slate-600 hover:text-slate-900 transition-all";
                }
            });
        };

        const updateLiquidationDisplay = () => {
            const buttons = [
                { btn: btnLiqDivisa, liq: 'DIVISA' },
                { btn: btnLiqBcv, liq: 'BS_BCV' },
                { btn: btnLiqUsdt, liq: 'BS_USDT' }
            ];

            buttons.forEach(({ btn, liq }) => {
                if (!btn) return;
                if (liq === selectedLiq) {
                    btn.className = "btn-liq-opt flex flex-col items-start p-2.5 rounded-xl border-2 border-[#FACC15] bg-amber-50/50 shadow-sm transition-all text-left";
                } else {
                    btn.className = "btn-liq-opt flex flex-col items-start p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-all text-left";
                }
            });

            // Regla: En EUR nunca mostrar opción P2P
            if (btnLiqUsdt) {
                if (expMoneda === 'EUR') {
                    btnLiqUsdt.classList.add('hidden');
                } else {
                    btnLiqUsdt.classList.remove('hidden');
                }
            }

            const totalNominal = Number(modalExpTotal?.value || 0);

            if (selectedLiq === 'DIVISA') {
                if (containerLiqDivisaBanner) containerLiqDivisaBanner.classList.remove('hidden');
                if (containerLiqBsDetails) containerLiqBsDetails.classList.add('hidden');
                if (lblLiqDivisaBannerText) {
                    lblLiqDivisaBannerText.textContent = `Se guardará en ${expMoneda} (Divisa directa).`;
                }
            } else {
                if (containerLiqDivisaBanner) containerLiqDivisaBanner.classList.add('hidden');
                if (containerLiqBsDetails) containerLiqBsDetails.classList.remove('hidden');

                const isBcv = (selectedLiq === 'BS_BCV');
                const rateBase = isBcv
                    ? (expMoneda === 'EUR' ? activeRates.eur : activeRates.usd)
                    : activeRates.usdt;

                const currentTasa = (modalExpTasa && Number(modalExpTasa.value) > 0)
                    ? Number(modalExpTasa.value)
                    : rateBase;

                if (modalExpTasa && (!modalExpTasa.value || !tasaModificadaManualmente)) {
                    modalExpTasa.value = currentTasa.toFixed(2);
                }

                if (!bolivaresAjustadosManualmente && modalExpBsFinal) {
                    const autoBs = totalNominal * currentTasa;
                    modalExpBsFinal.value = autoBs > 0 ? autoBs.toFixed(2) : '';
                }

                if (lblLiqRateDesc) {
                    const rateName = isBcv ? 'Tasa BCV' : 'Tasa P2P';
                    const unitName = expMoneda === 'EUR' ? 'euro' : 'dólar';
                    lblLiqRateDesc.textContent = `${rateName}: Bs. ${currentTasa.toFixed(2)} por ${unitName}`;
                }
            }
        };

        const updateCurrencyDisplay = () => {
            if (modalExpTotalPrefix) {
                modalExpTotalPrefix.textContent = getCurrencySymbol(expMoneda);
            }

            if (expMoneda === 'USD') {
                setCurrencyButtonActive(btnCurrencyUsd);
                if (containerVesEquivalencias) containerVesEquivalencias.classList.add('hidden');
                if (containerUsdtInfo) containerUsdtInfo.classList.add('hidden');
                if (containerFormaPago) containerFormaPago.classList.remove('hidden');
                updateLiquidationDisplay();
            } else if (expMoneda === 'VES') {
                setCurrencyButtonActive(btnCurrencyVes);
                if (containerVesEquivalencias) containerVesEquivalencias.classList.remove('hidden');
                if (containerUsdtInfo) containerUsdtInfo.classList.add('hidden');
                if (containerFormaPago) containerFormaPago.classList.add('hidden');

                const totalBs = Number(modalExpTotal?.value || 0);
                const usdEquiv = activeRates.usd > 0 ? (totalBs / activeRates.usd) : 0;
                const eurEquiv = activeRates.eur > 0 ? (totalBs / activeRates.eur) : 0;
                const usdtEquiv = activeRates.usdt > 0 ? (totalBs / activeRates.usdt) : 0;

                if (vesEquivUsd) vesEquivUsd.textContent = `$ ${usdEquiv.toFixed(2)}`;
                if (vesEquivEur) vesEquivEur.textContent = `€ ${eurEquiv.toFixed(2)}`;
                if (vesEquivUsdt) vesEquivUsdt.textContent = `${usdtEquiv.toFixed(2)} USDT`;

                if (vesRatesStatusBadge) {
                    vesRatesStatusBadge.textContent = tasaModificadaManualmente
                        ? 'Tasa personalizada activa'
                        : (activeRates.isHistorical ? `Tasas del ${activeRates.dateLabel}` : 'Tasas oficiales de hoy');
                }

                if (showingVesRatesAdjust && inputVesRateAdjust) {
                    let rateToShow = activeRates.usd;
                    if (activeVesAdjustCurrency === 'EUR') rateToShow = activeRates.eur;
                    else if (activeVesAdjustCurrency === 'USDT') rateToShow = activeRates.usdt;
                    inputVesRateAdjust.value = rateToShow > 0 ? rateToShow.toFixed(2) : '';
                }
            } else if (expMoneda === 'USDT') {
                setCurrencyButtonActive(btnCurrencyUsdt);
                if (containerVesEquivalencias) containerVesEquivalencias.classList.add('hidden');
                if (containerUsdtInfo) containerUsdtInfo.classList.remove('hidden');
                if (containerFormaPago) containerFormaPago.classList.add('hidden');
            } else if (expMoneda === 'EUR') {
                setCurrencyButtonActive(btnCurrencyEur);
                if (containerVesEquivalencias) containerVesEquivalencias.classList.add('hidden');
                if (containerUsdtInfo) containerUsdtInfo.classList.add('hidden');
                if (containerFormaPago) containerFormaPago.classList.remove('hidden');
                if (selectedLiq === 'BS_USDT') selectedLiq = 'BS_BCV';
                updateLiquidationDisplay();
            }

            checkDiscrepancy();
        };

        const selectCurrency = async (cur) => {
            if (expMoneda === cur) return; // Interacción no destructiva al re-pulsar
            expMoneda = cur;
            if (cur === 'EUR' && selectedLiq === 'BS_USDT') {
                selectedLiq = 'BS_BCV';
            }
            renderExpenseItems();
            updateCurrencyDisplay();
        };

        btnCurrencyUsd?.addEventListener('click', () => selectCurrency('USD'));
        btnCurrencyVes?.addEventListener('click', () => selectCurrency('VES'));
        btnCurrencyUsdt?.addEventListener('click', () => selectCurrency('USDT'));
        btnCurrencyEur?.addEventListener('click', () => selectCurrency('EUR'));

        btnLiqDivisa?.addEventListener('click', () => {
            if (selectedLiq === 'DIVISA') return;
            selectedLiq = 'DIVISA';
            bolivaresAjustadosManualmente = false;
            tasaModificadaManualmente = false;
            updateLiquidationDisplay();
        });

        btnLiqBcv?.addEventListener('click', () => {
            if (selectedLiq === 'BS_BCV') return;
            selectedLiq = 'BS_BCV';
            bolivaresAjustadosManualmente = false;
            tasaModificadaManualmente = false;
            if (modalExpTasa) {
                const base = expMoneda === 'EUR' ? activeRates.eur : activeRates.usd;
                modalExpTasa.value = base.toFixed(2);
            }
            updateLiquidationDisplay();
        });

        btnLiqUsdt?.addEventListener('click', () => {
            if (expMoneda === 'EUR' || selectedLiq === 'BS_USDT') return;
            selectedLiq = 'BS_USDT';
            bolivaresAjustadosManualmente = false;
            tasaModificadaManualmente = false;
            if (modalExpTasa) {
                modalExpTasa.value = activeRates.usdt.toFixed(2);
            }
            updateLiquidationDisplay();
        });

        // Sincronización bidireccional entre Bolívares y Tasa cobrada en caja
        modalExpBsFinal?.addEventListener('input', (e) => {
            bolivaresAjustadosManualmente = true;
            tasaModificadaManualmente = true;
            const valBs = Number(e.target.value) || 0;
            const totalNom = Number(modalExpTotal?.value || 0);
            if (valBs > 0 && totalNom > 0 && modalExpTasa) {
                const effectiveRate = valBs / totalNom;
                modalExpTasa.value = effectiveRate.toFixed(2);
                if (lblLiqRateDesc) {
                    const rateName = selectedLiq === 'BS_BCV' ? 'Tasa BCV' : 'Tasa P2P';
                    const unitName = expMoneda === 'EUR' ? 'euro' : 'dólar';
                    lblLiqRateDesc.textContent = `${rateName} efectiva: Bs. ${effectiveRate.toFixed(2)} por ${unitName}`;
                }
            }
        });

        modalExpTasa?.addEventListener('input', (e) => {
            tasaModificadaManualmente = true;
            const valRate = Number(e.target.value) || 0;
            const totalNom = Number(modalExpTotal?.value || 0);
            if (valRate > 0) {
                if (modalExpBsFinal && totalNom > 0) {
                    const newBs = totalNom * valRate;
                    modalExpBsFinal.value = newBs.toFixed(2);
                    bolivaresAjustadosManualmente = true;
                }
                if (lblLiqRateDesc) {
                    const rateName = selectedLiq === 'BS_BCV' ? 'Tasa BCV' : 'Tasa P2P';
                    const unitName = expMoneda === 'EUR' ? 'euro' : 'dólar';
                    lblLiqRateDesc.textContent = `${rateName}: Bs. ${valRate.toFixed(2)} por ${unitName}`;
                }
            }
        });

        btnToggleLiqRate?.addEventListener('click', () => {
            showingLiqRateAdjust = !showingLiqRateAdjust;
            if (containerLiqRateInput) {
                containerLiqRateInput.classList.toggle('hidden', !showingLiqRateAdjust);
            }
            if (btnToggleLiqRateIcon) {
                btnToggleLiqRateIcon.textContent = showingLiqRateAdjust ? '▴' : '▾';
            }
        });

        btnRestoreLiqRate?.addEventListener('click', () => {
            const isBcv = (selectedLiq === 'BS_BCV');
            const offRate = isBcv
                ? (expMoneda === 'EUR' ? officialRates.eur : officialRates.usd)
                : officialRates.usdt;

            if (modalExpTasa) modalExpTasa.value = offRate.toFixed(2);
            tasaModificadaManualmente = false;
            bolivaresAjustadosManualmente = false;
            const totalNom = Number(modalExpTotal?.value || 0);
            if (modalExpBsFinal && totalNom > 0) {
                modalExpBsFinal.value = (totalNom * offRate).toFixed(2);
            }
            updateLiquidationDisplay();
        });

        // Toggle y chips para ajustar tasas en VES
        btnToggleVesRates?.addEventListener('click', () => {
            showingVesRatesAdjust = !showingVesRatesAdjust;
            if (containerVesRatesAdjust) {
                containerVesRatesAdjust.classList.toggle('hidden', !showingVesRatesAdjust);
            }
            if (btnToggleVesRatesIcon) {
                btnToggleVesRatesIcon.textContent = showingVesRatesAdjust ? '▴' : '▾';
            }
            updateCurrencyDisplay();
        });

        document.querySelectorAll('.ves-rate-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                const cur = chip.getAttribute('data-ves-chip');
                if (!cur) return;
                activeVesAdjustCurrency = cur;
                document.querySelectorAll('.ves-rate-chip').forEach(c => {
                    const isTarget = c.getAttribute('data-ves-chip') === cur;
                    c.className = isTarget
                        ? "ves-rate-chip flex-1 py-1 text-[11px] font-bold rounded-lg border border-[#FACC15] bg-amber-50 text-slate-800"
                        : "ves-rate-chip flex-1 py-1 text-[11px] font-medium rounded-lg border border-slate-200 text-slate-600";
                });
                if (lblVesRateHelper) {
                    lblVesRateHelper.textContent = `Ajustar tasa para ${cur} correspondiente al ${activeRates.dateLabel}.`;
                }
                updateCurrencyDisplay();
            });
        });

        inputVesRateAdjust?.addEventListener('input', (e) => {
            const val = Number(e.target.value) || 0;
            if (val > 0) {
                tasaModificadaManualmente = true;
                if (activeVesAdjustCurrency === 'USD') activeRates.usd = val;
                else if (activeVesAdjustCurrency === 'EUR') activeRates.eur = val;
                else if (activeVesAdjustCurrency === 'USDT') activeRates.usdt = val;
                updateCurrencyDisplay();
            }
        });

        btnRestoreVesRate?.addEventListener('click', () => {
            if (activeVesAdjustCurrency === 'USD') activeRates.usd = officialRates.usd;
            else if (activeVesAdjustCurrency === 'EUR') activeRates.eur = officialRates.eur;
            else if (activeVesAdjustCurrency === 'USDT') activeRates.usdt = officialRates.usdt;
            tasaModificadaManualmente = false;
            updateCurrencyDisplay();
        });

        // Input de Monto Total (Protección de Total Dictado)
        modalExpTotal?.addEventListener('input', () => {
            totalEditadoManualmente = true;
            bolivaresAjustadosManualmente = false;
            checkDiscrepancy();
            updateCurrencyDisplay();
        });

        // Selector de Fecha e Histórico DolarAPI con guarda de carrera
        modalExpFecha?.addEventListener('change', async () => {
            const f = modalExpFecha.value;
            if (!f) return;

            const myReqId = ++dateRateRequestId;
            const todayStr = new Date().toISOString().substring(0, 10);
            const isToday = (f === todayStr);

            if (isToday) {
                activeRates.usd = liveRates.usd > 0 ? liveRates.usd : 36.5;
                activeRates.eur = liveRates.eur > 0 ? liveRates.eur : 40.0;
                activeRates.usdt = liveRates.usdt > 0 ? liveRates.usdt : 36.5;
                activeRates.dateLabel = 'Hoy';
                activeRates.isHistorical = false;
                officialRates = { ...activeRates };

                if (modalExpFechaInfo) modalExpFechaInfo.classList.add('hidden');
                tasaModificadaManualmente = false;
                bolivaresAjustadosManualmente = false;
                updateCurrencyDisplay();
                return;
            }

            if (modalExpFechaInfo) {
                modalExpFechaInfo.classList.remove('hidden');
                if (modalExpFechaInfoText) {
                    modalExpFechaInfoText.textContent = 'Consultando tasa oficial histórica...';
                }
            }

            const hist = await fetchHistoricalRatesForDate(f);
            if (myReqId !== dateRateRequestId) return; // Guarda contra respuestas viejas

            if (hist && hist.usd && hist.usd.rate > 0) {
                activeRates.usd = hist.usd.rate;
                activeRates.eur = hist.eur && hist.eur.rate > 0 ? hist.eur.rate : activeRates.usd;
                activeRates.usdt = hist.usdt && hist.usdt.rate > 0 ? hist.usdt.rate : activeRates.usd;
                activeRates.isHistorical = true;
                const refDate = hist.usd.date || f;
                activeRates.dateLabel = refDate;
                officialRates = { ...activeRates };

                if (modalExpFechaInfoText) {
                    modalExpFechaInfoText.textContent = `Se usará la tasa oficial del ${refDate}`;
                }
                tasaModificadaManualmente = false;
                bolivaresAjustadosManualmente = false;
                updateCurrencyDisplay();
            } else {
                if (!editingGastoId) {
                    // Fail-closed en gastos nuevos: no usar tasa de hoy
                    if (modalExpFechaInfoText) {
                        modalExpFechaInfoText.textContent = 'No se encontró tasa histórica oficial. Por favor indica la tasa de ese día.';
                    }
                }
            }
        });

        btnAddItem?.addEventListener('click', () => {
            modalExpenseItems.push({
                descripcion: '',
                cantidad: 1,
                precio: '',
                total: '',
                categoria: 'Otros',
                categoriaManual: false
            });
            renderExpenseItems();
        });

        const openExpenseModal = () => {
            editingGastoId = null;
            const modalTitle = document.getElementById('modal-expense-title');
            if (modalTitle) modalTitle.textContent = "Registrar gasto";
            if (btnSaveExpenseModal) {
                const sp = btnSaveExpenseModal.querySelector('span');
                if (sp) sp.textContent = "Guardar Gasto";
            }

            if (modalExpComercio) modalExpComercio.value = '';
            if (modalExpTotal) modalExpTotal.value = '';
            selectedLiq = 'DIVISA';
            expMoneda = 'USD';
            bolivaresAjustadosManualmente = false;
            totalEditadoManualmente = false;
            tasaModificadaManualmente = false;
            showingVesRatesAdjust = false;
            showingLiqRateAdjust = false;

            activeRates = {
                usd: liveRates.usd > 0 ? liveRates.usd : 36.5,
                eur: liveRates.eur > 0 ? liveRates.eur : 40.0,
                usdt: liveRates.usdt > 0 ? liveRates.usdt : 36.5,
                dateLabel: 'Hoy',
                isHistorical: false,
            };
            officialRates = { ...activeRates };

            // Cálculo seguro de fecha (evita desbordamientos tipo 31 de febrero)
            const today = new Date();
            const isCurrentMonth = (today.getFullYear() === selectedYear && (today.getMonth() + 1) === selectedMonth);
            let dayVal;
            if (isCurrentMonth) {
                dayVal = today.getDate();
            } else {
                const daysInMonth = new Date(selectedYear, selectedMonth, 0).getDate();
                dayVal = Math.min(today.getDate(), daysInMonth);
            }
            const monthStr = String(selectedMonth).padStart(2, '0');
            const dayStr = String(dayVal).padStart(2, '0');
            if (modalExpFecha) {
                modalExpFecha.value = `${selectedYear}-${monthStr}-${dayStr}`;
                modalExpFecha.max = today.toISOString().substring(0, 10);
            }
            if (modalExpFechaInfo) modalExpFechaInfo.classList.add('hidden');

            // Iniciar con 1 ítem vacío
            modalExpenseItems = [
                { descripcion: '', cantidad: 1, precio: '', total: '', categoria: 'Otros', categoriaManual: false }
            ];

            renderExpenseItems();
            updateCurrencyDisplay();

            if (modalExpense) {
                modalExpense.classList.remove('hidden');
                modalExpense.classList.add('flex');
            }
        };

        const openEditExpenseModal = (gasto) => {
            if (!gasto) return;
            editingGastoId = gasto.id;

            const modalTitle = document.getElementById('modal-expense-title');
            if (modalTitle) modalTitle.textContent = "Editar gasto";
            if (btnSaveExpenseModal) {
                const sp = btnSaveExpenseModal.querySelector('span');
                if (sp) sp.textContent = "Actualizar Gasto";
            }

            if (modalExpComercio) modalExpComercio.value = gasto.comercio || '';
            if (modalExpFecha) {
                modalExpFecha.value = gasto.fecha || '';
                modalExpFecha.max = new Date().toISOString().substring(0, 10);
            }
            if (modalExpFechaInfo) modalExpFechaInfo.classList.add('hidden');

            const fuente = gasto.fuente_tasa_cambio || '';
            const esIndexadoEur = (gasto.moneda === 'VES' && fuente.includes('indexado a EUR'));
            const esIndexadoBcv = (gasto.moneda === 'VES' && !esIndexadoEur && (fuente.includes('indexado a USD') || fuente.includes('BCV (Pago en Bs.')));
            const esIndexadoUsdt = (gasto.moneda === 'VES' && (fuente.includes('indexado a USDT') || fuente.includes('Binance P2P')));
            const esIndexado = esIndexadoEur || esIndexadoBcv || esIndexadoUsdt;

            const totalBsOriginal = (Number(gasto.total_original || 0) / 100.0);
            const totalUsdDoc = (Number(gasto.total_usd || 0) / 100.0);
            const totalEurDoc = (Number(gasto.total_eur || 0) / 100.0);

            activeRates.usd = Number(gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_cambio) : (liveRates.usd || 36.5);
            activeRates.eur = Number(gasto.tasa_eur || 0) > 0 ? Number(gasto.tasa_eur) : (liveRates.eur || 40.0);
            activeRates.usdt = Number(gasto.tasa_usdt || 0) > 0 ? Number(gasto.tasa_usdt) : (liveRates.usdt || 36.5);
            activeRates.dateLabel = gasto.fecha_tasa_cambio || gasto.fecha || 'Guardada';
            activeRates.isHistorical = true;
            officialRates = { ...activeRates };

            totalEditadoManualmente = true; // Al editar, preservar el total existente

            if (esIndexadoEur) {
                expMoneda = 'EUR';
                selectedLiq = 'BS_BCV';
                const tasaVal = Number(gasto.tasa_cambio || gasto.tasa_eur || 0) > 0 ? Number(gasto.tasa_cambio || gasto.tasa_eur) : (activeRates.eur || 1.0);
                const totalEur = tasaVal > 0 && totalBsOriginal > 0 ? (totalBsOriginal / tasaVal) : totalEurDoc;
                if (modalExpTotal) modalExpTotal.value = totalEur > 0 ? totalEur.toFixed(2) : '';
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = true;
            } else if (esIndexadoBcv) {
                expMoneda = 'USD';
                selectedLiq = 'BS_BCV';
                const tasaVal = Number(gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_cambio) : (activeRates.usd || 1.0);
                if (modalExpTotal) modalExpTotal.value = totalUsdDoc > 0 ? totalUsdDoc.toFixed(2) : '';
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = true;
            } else if (esIndexadoUsdt) {
                expMoneda = 'USD';
                selectedLiq = 'BS_USDT';
                const tasaVal = Number(gasto.tasa_usdt || gasto.tasa_cambio || 0) > 0 ? Number(gasto.tasa_usdt || gasto.tasa_cambio) : (activeRates.usdt || 1.0);
                const totalUsdtDoc = (Number(gasto.total_usdt || 0) / 100.0);
                if (modalExpTotal) modalExpTotal.value = totalUsdtDoc > 0 ? totalUsdtDoc.toFixed(2) : (totalUsdDoc > 0 ? totalUsdDoc.toFixed(2) : '');
                if (modalExpTasa) modalExpTasa.value = tasaVal.toFixed(2);
                bolivaresAjustadosManualmente = true;
            } else {
                expMoneda = gasto.moneda || 'USD';
                selectedLiq = gasto.metodo_liquidacion || ((expMoneda === 'USD' || expMoneda === 'EUR') ? 'DIVISA' : 'BS_BCV');
                const totalOrig = (Number(gasto.total_original || 0) / 100.0);
                if (modalExpTotal) modalExpTotal.value = totalOrig > 0 ? totalOrig.toFixed(2) : '';
                bolivaresAjustadosManualmente = false;
            }

            const inputNominal = Number(modalExpTotal?.value || 0);
            const rateConversion = esIndexado
                ? (inputNominal > 0 && totalBsOriginal > 0 ? (totalBsOriginal / inputNominal) : (Number(modalExpTasa?.value) || 1.0))
                : 1.0;

            if (gasto.items && gasto.items.length > 0) {
                modalExpenseItems = gasto.items.map(it => {
                    const cant = Number(it.cantidad) || 1;
                    const origBsTotal = Number(it.total) || 0;
                    const origBsPrecio = Number(it.precio_unitario) || 0;
                    const totRaw = origBsTotal / 100.0;
                    const prRaw = origBsPrecio / 100.0;

                    const tot = esIndexado && rateConversion > 0 ? (totRaw / rateConversion) : totRaw;
                    const pr = esIndexado && rateConversion > 0 ? (prRaw / rateConversion) : (prRaw > 0 ? prRaw : (cant > 0 ? tot / cant : tot));

                    const precioStr = pr > 0 ? pr.toFixed(2) : '';
                    const totalStr = tot > 0 ? tot.toFixed(2) : '';

                    return {
                        descripcion: it.descripcion || '',
                        cantidad: cant,
                        precio: precioStr,
                        total: totalStr,
                        categoria: it.categoria || 'Otros',
                        categoriaManual: true,
                        origBsPrecio: esIndexado ? origBsPrecio : null,
                        origBsTotal: esIndexado ? origBsTotal : null,
                        initPrecio: Number(precioStr) || 0,
                        initCant: cant,
                        initRate: esIndexado ? rateConversion : null,
                    };
                });
            } else {
                modalExpenseItems = [
                    { descripcion: '', cantidad: 1, precio: '', total: '', categoria: gasto.categoria || 'Otros', categoriaManual: true }
                ];
            }

            renderExpenseItems();
            updateCurrencyDisplay();

            if (esIndexado && modalExpBsFinal && totalBsOriginal > 0) {
                modalExpBsFinal.value = totalBsOriginal.toFixed(2);
            }

            if (modalExpense) {
                modalExpense.classList.remove('hidden');
                modalExpense.classList.add('flex');
            }
        };

        const closeExpenseModal = () => {
            if (modalExpense) {
                modalExpense.classList.add('hidden');
                modalExpense.classList.remove('flex');
            }
        };

        btnOpenExpenseModal?.addEventListener('click', openExpenseModal);
        btnCloseExpenseModal?.addEventListener('click', closeExpenseModal);

        // Procedimiento de guardado definitivo con paridad matemática al céntimo
        const executeSaveExpense = async () => {
            if (!currentUser) return;

            const comercio = (modalExpComercio?.value || '').trim() || 'Compra general';
            const fecha = modalExpFecha?.value;
            const monto = Number(modalExpTotal?.value || 0);

            if (!fecha) {
                alert("Por favor selecciona la fecha del gasto.");
                return;
            }
            if (monto <= 0) {
                alert("Por favor indica el monto total del gasto.");
                return;
            }

            const tasaCobradaVal = (selectedLiq === 'BS_BCV' || selectedLiq === 'BS_USDT')
                ? (modalExpTasa && Number(modalExpTasa.value) > 0 ? Number(modalExpTasa.value) : null)
                : null;

            const bolivaresManualesVal = bolivaresAjustadosManualmente && modalExpBsFinal
                ? Number(modalExpBsFinal.value || 0)
                : null;

            const computed = computeExpenseTotals({
                moneda: expMoneda,
                monto: monto,
                metodoLiquidacion: selectedLiq,
                tasaUsd: activeRates.usd,
                tasaEur: activeRates.eur,
                tasaUsdt: activeRates.usdt,
                tasaCobrada: tasaCobradaVal,
                bolivaresManuales: bolivaresManualesVal,
            });

            // Preparar ítems preservando centavos originales
            const validItems = modalExpenseItems
                .filter(it => (it.descripcion || '').trim() || (Number(it.precio) || 0) > 0 || (Number(it.total) || 0) > 0)
                .map((it, idx) => {
                    const cant = Number(it.cantidad) || 1;
                    const prNominal = Number(it.precio) || 0;
                    const cents = computeItemCents(it, computed.ratioConversionItems);

                    const descFinal = (it.descripcion || '').trim() || `Producto ${idx + 1}`;
                    return {
                        descripcion: descFinal,
                        descripcion_norm: normalizeProductText(descFinal),
                        cantidad: cant,
                        precio_unitario: cents.precio_unitario,
                        total: cents.total,
                        categoria: normalizarCategoria(it.categoria || 'Otros'),
                    };
                });

            // Sincronizar renglones IVA con la categoría dominante
            const finalItems = sincronizarCategoriaImpuestos(validItems);

            // Categoría predominante del documento
            let primaryCat = 'Otros';
            const catTotals = {};
            finalItems.forEach(it => {
                if (!isTaxDescription(it.descripcion)) {
                    catTotals[it.categoria] = (catTotals[it.categoria] || 0) + (it.total || 0);
                }
            });
            const entries = Object.entries(catTotals);
            if (entries.length > 0) {
                primaryCat = entries.reduce((a, b) => (b[1] >= a[1] ? b : a))[0] || 'Otros';
            } else if (finalItems.length > 0) {
                primaryCat = normalizarCategoria(finalItems[0].categoria);
            }

            const gastoId = editingGastoId || (crypto.randomUUID ? crypto.randomUUID() : `web_${Date.now()}`);
            const docRef = doc(db, 'users', currentUser.uid, 'gastos', gastoId);

            // A-09 y A-15: Allowlist de metadatos y confirmación de cambio de importe
            const targetGasto = editingGastoId ? currentGastos.find(g => g.id === editingGastoId) : null;
            if (targetGasto) {
                const origTotal = Number(targetGasto.total_original || 0);
                const origMoneda = targetGasto.moneda || 'USD';
                const financialsChanged = (origTotal !== computed.total_original) || (origMoneda !== computed.moneda);

                if (financialsChanged) {
                    const montoAnteriorStr = formatMoney(origTotal / 100.0, origMoneda);
                    const montoNuevoStr = formatMoney(computed.total_original / 100.0, computed.moneda);
                    const confirmed = confirm(`¿Confirmas el cambio de monto?\n\nEstás modificando el importe registrado de ${montoAnteriorStr} a ${montoNuevoStr}. Esta acción recalculará las equivalencias asociadas.`);
                    if (!confirmed) {
                        return;
                    }
                } else {
                    // Edición ordinaria de metadatos (A-09): aislar estrictamente el payload
                    try {
                        if (btnSaveExpenseModal) {
                            btnSaveExpenseModal.disabled = true;
                            btnSaveExpenseModal.innerHTML = `<span>Guardando...</span>`;
                        }
                        const metadataPayload = {
                            comercio: comercio,
                            fecha: fecha,
                            categoria: primaryCat,
                            items: finalItems,
                            actualizado_en: new Date().toISOString(),
                        };
                        await updateDoc(docRef, metadataPayload);
                        closeExpenseModal();
                        await loadDashboardData();
                        return;
                    } catch (err) {
                        console.error("Error al actualizar metadatos del gasto:", err);
                        alert("No se pudo actualizar la información del gasto.");
                        return;
                    } finally {
                        if (btnSaveExpenseModal) {
                            btnSaveExpenseModal.disabled = false;
                            btnSaveExpenseModal.innerHTML = `<span>Actualizar Gasto</span>`;
                        }
                    }
                }
            }

            try {
                if (btnSaveExpenseModal) {
                    btnSaveExpenseModal.disabled = true;
                    btnSaveExpenseModal.innerHTML = `<span>Guardando...</span>`;
                }

                const payload = {
                    uuid: gastoId,
                    comercio: comercio,
                    fecha: fecha,
                    moneda: computed.moneda,
                    total_original: computed.total_original,
                    total_usd: computed.total_usd,
                    total_usdt: computed.total_usdt,
                    total_eur: computed.total_eur,
                    tasa_cambio: computed.tasa_cambio,
                    tasa_usdt: computed.tasa_usdt,
                    tasa_eur: computed.tasa_eur,
                    metodo_liquidacion: computed.metodo_liquidacion,
                    fuente_tasa_cambio: computed.fuente_tasa_cambio,
                    fecha_tasa_cambio: activeRates.dateLabel || fecha,
                    categoria: primaryCat,
                    items: finalItems,
                    actualizado_en: new Date().toISOString(),
                    synced: 1
                };

                if (!editingGastoId) {
                    payload.creado_en = new Date().toISOString();
                }

                await setDoc(docRef, payload, { merge: true });

                closeExpenseModal();
                await loadDashboardData();
            } catch (err) {
                console.error("Error al registrar o actualizar gasto:", err);
                alert("No se pudo guardar el gasto.");
            } finally {
                if (btnSaveExpenseModal) {
                    btnSaveExpenseModal.disabled = false;
                    btnSaveExpenseModal.innerHTML = `<span>${editingGastoId ? 'Actualizar Gasto' : 'Guardar Gasto'}</span>`;
                }
            }
        };

        btnSaveExpenseModal?.addEventListener('click', async () => {
            const sum = getItemsSum();
            const grandTotal = Number(modalExpTotal?.value || 0);
            const diff = Math.abs(sum - grandTotal);
            const hasItems = modalExpenseItems.length > 0 && modalExpenseItems.some(it => (it.descripcion || '').trim() || (Number(it.precio) || 0) > 0);

            if (hasItems && sum > 0 && grandTotal > 0 && diff > 0.05) {
                // Diálogo de decisión accesible en vez de confirm()
                if (modalDiscrepancyDesc) {
                    modalDiscrepancyDesc.textContent = `La suma de los artículos (${formatMoney(sum, expMoneda)}) no coincide con el Monto total general (${formatMoney(grandTotal, expMoneda)}). ¿Deseas ajustar el monto total a la suma de los productos?`;
                }
                if (modalDiscrepancyDecision) {
                    modalDiscrepancyDecision.classList.remove('hidden');
                    modalDiscrepancyDecision.classList.add('flex');
                }

                const closeDecision = () => {
                    if (modalDiscrepancyDecision) {
                        modalDiscrepancyDecision.classList.add('hidden');
                        modalDiscrepancyDecision.classList.remove('flex');
                    }
                };

                if (btnDiscrepancyAdjust) {
                    btnDiscrepancyAdjust.onclick = async () => {
                        closeDecision();
                        if (modalExpTotal) modalExpTotal.value = sum.toFixed(2);
                        totalEditadoManualmente = false;
                        bolivaresAjustadosManualmente = false;
                        updateCurrencyDisplay();
                        await executeSaveExpense();
                    };
                }

                if (btnDiscrepancyKeep) {
                    btnDiscrepancyKeep.onclick = async () => {
                        closeDecision();
                        await executeSaveExpense();
                    };
                }

                if (btnDiscrepancyCancel) {
                    btnDiscrepancyCancel.onclick = () => {
                        closeDecision();
                    };
                }
                return;
            }

            await executeSaveExpense();
        });

    </script>
</body>
</html>
