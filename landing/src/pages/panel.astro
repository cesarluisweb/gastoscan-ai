                setCurrencyButtonActive(btnCurrencyUsd);
                if (labelTasaCambio) labelTasaCambio.textContent = "Tasa de cambio USD (BCV)";
                if (labelMontoTotal) labelMontoTotal.textContent = "Monto Total (USD $)";
                if (containerLiq) containerLiq.classList.remove('hidden');
                updateLiquidationDisplay();
                // Ocultar preview redundante en el título para USD con liquidación
