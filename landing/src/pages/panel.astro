                    await createUserWithEmailAndPassword(auth, email, password);
                } else {
                    await signInWithEmailAndPassword(auth, email, password);
                }
            } catch (err) {
                console.error("Error de autenticación:", err);
                setAuthMessage(getAuthErrorMessage(err.code), true);
            } finally {
                if (btnAuthEmailSubmit) {
                    btnAuthEmailSubmit.disabled = false;
                    const sp = btnAuthEmailSubmit.querySelector('span');
                    if (sp) sp.textContent = isRegisterMode ? 'Crear cuenta' : 'Iniciar sesión';
