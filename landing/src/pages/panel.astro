        const vesRatesStatusBadge = document.getElementById('ves-rates-status-badge');
        const btnToggleVesRates = document.getElementById('btn-toggle-ves-rates');
        const btnToggleVesRatesIcon = document.getElementById('btn-toggle-ves-rates-icon');
        const containerVesRatesAdjust = document.getElementById('container-ves-rates-adjust');
        const inputVesRateAdjust = document.getElementById('input-ves-rate-adjust');
        const btnRestoreVesRate = document.getElementById('btn-restore-ves-rate');
        const lblVesRateHelper = document.getElementById('lbl-ves-rate-helper');
