---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rinde Más | El control de gastos inteligente</title>
    <meta name="description" content="Lleva el control de tus finanzas personales fácilmente. Escanea tus facturas con IA y deja que Rinde Más haga el trabajo por ti.">
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
</head>
<body class="bg-[#F8FAFC] text-slate-800 font-sans antialiased selection:bg-[#FDE047] selection:text-slate-900">
    
    <!-- Navbar -->
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex-shrink-0 flex items-center gap-3">
                    <img src="/logo.jpg" alt="Logo Rinde Más" class="w-10 h-10 rounded-xl shadow-sm" />
                    <span class="font-bold text-xl tracking-tight text-slate-900">Rinde Más</span>
                </div>
                <div class="flex">
                    <a href="#descargar" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-slate-900 transition-all bg-[#FDE047] hover:bg-[#FACC15] rounded-full shadow-sm hover:shadow-md ring-1 ring-inset ring-[#FDE047]">
                        Descargar App
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <main class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 lg:pb-32 overflow-hidden">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative text-center">
            <h1 class="mx-auto max-w-4xl font-display text-5xl font-extrabold tracking-tight text-slate-900 sm:text-7xl">
                Tus gastos bajo control, <span class="relative whitespace-nowrap text-[#D97706]">
